function UnEquip(thePlayer, invname, x, y, item)
	if(item == "Патроны") then
		local WNA = WeaponAmmo[WeaponNamesArr[InitHud[invname][x][y]["txd"]]]
		local it = table.copy(InitHud[invname][x][y][WNA])
		InitHud[invname][x][y][WNA] = nil
		AddInventoryItem(invname, it)
	else
		local it = table.copy(InitHud[invname][x][y][item])
		InitHud[invname][x][y][item] = nil
		AddInventoryItem(invname, it)
	end
	triggerServerEvent("useinvweapon", localPlayer, localPlayer)
	
	PText["Inventory"] = {}
end
