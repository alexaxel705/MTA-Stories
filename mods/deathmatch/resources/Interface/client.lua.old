	dxDrawBorderedText(IDF, 530*scalex, 335*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*0.7, "default-bold", "left", "top", false, false, false, true)
	dxDrawBorderedText(NF, 570*scalex, 335*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*0.7, "default-bold", "left", "top", false, false, false, true)
	dxDrawBorderedText(RANG, 830*scalex, 335*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*0.7, "default-bold", "left", "top", false, false, false, true)
	dxDrawBorderedText(PING, 1220*scalex, 335*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*0.7, "default-bold", "left", "top", false, false, false, true)
	
