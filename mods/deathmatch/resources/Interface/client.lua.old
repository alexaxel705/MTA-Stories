			dxDrawBorderedText(Gear.." ", 0,y-(100*scaley),x-(100*scalex),0, tocolor(150,150,150,255), scale, "default-bold", "right")
		--end
		
		if(isElement(VehicleTrack)) then
			if(not getPedControlState(localPlayer, "accelerate")) then
				setSoundSpeed(VehicleTrack, 0)
				setSoundVolume(VehicleTrack, 0)
