function LoadedRes()
	triggerEvent("GenerateTexture", root, MyTextures)
	
	UpdateTargets() -- Начальная отрисовка
	
	if(getPedOccupiedVehicle(localPlayer)) then
		ClientVehicleEnter(localPlayer, 0)
	end
	
	local losca = 2
	for font, dat in pairs(FontPos) do
		Pricedown[font] = dxCreateRenderTarget(32+(losca*2),32+(losca*2), true)
		dxSetRenderTarget(Pricedown[font], true)
		dxSetBlendMode("modulate_add")
	
		for oX = -losca, losca do 
			for oY = -losca, losca do 
				dxDrawImageSection((losca*1.5)+oX,(losca*1.5)+oY, 32, 32, 32*dat[1],14+(32*dat[2]), 32, 32,"icons/font.png", 0, 0, 0, tocolor(0,0,0,255))
			end
		end
		
		dxDrawImageSection((losca*1.5),(losca*1.5), 32, 32, 32*dat[1],14+(32*dat[2]), 32, 32,"icons/font.png", 0, 0, 0, tocolor(255,255,255,255))
		
		dxSetBlendMode("blend")
		dxSetRenderTarget()
	end
end
addEventHandler("onClientResourceStart", getResourceRootElement(), LoadedRes)





function GenerateTextureCompleted(textures) -- Третий этап загрузки
	for name, texture in pairs(textures) do
		items[name][1] = texture
	end
	
	triggerServerEvent("SyncTime", localPlayer, localPlayer)
end
addEvent("GenerateTextureCompleted", true)
addEventHandler("GenerateTextureCompleted", localPlayer, GenerateTextureCompleted)





function math.round(number, decimals, method)
    decimals = decimals or 0
    local factor = 10 ^ decimals
    if (method == "ceil" or method == "floor") then return math[method](number * factor) / factor
    else return tonumber(("%."..decimals.."f"):format(number)) end
end



function CreateInventory(h,w)
	local out = {}
	for x = 1, h do
		out[x] = {}
		for y = 1, w do
			out[x][y] = {}
		end
	end
	return out
end


local PlayerInventory = fromJSON(getElementData(localPlayer, "inv")) or false


function AuthInterface(arr)
	PlayerInventory = fromJSON(arr)
end
addEvent("AuthInterface", true)
addEventHandler("AuthInterface", localPlayer, AuthInterface)




function GetItemCount(item)
	return item["count"] or 1
end

function GetItemQuality(item)
	return item["quality"] or 550
end



function GetUsableSlot()
	local dat = getElementData(localPlayer, "WeaponSlot")
	if(dat) then
		return fromJSON(dat)
	else
		return false
	end
end


function GetItemMass(item)
	local gr = false
	if(item["mass"]) then gr = item["mass"] end
	if(not gr) then gr = items[item["txd"]][5] end
	
	if(gr >= 1000) then
		return (gr/1000).."кг"
	else
		return gr.."г"
	end
end

function GetItemCost(it)
	if(it["cost"]) then
		return it["cost"] 
	end
	cost = items[it["txd"]][6]
	
	local Economics = fromJSON(getElementData(root, "Economics"))
	
	if(Economics[it["txd"]]) then cost = cost*Economics[it["txd"]] end
	
	
	if(cost <= 0) then cost = 1 end
	return math.round(cost*(GetItemQuality(it)/450), 0)
end



function GetQualityColor(quality)
	if(not quality or quality <= 99) then
		return "#CC0000"
	elseif(quality <= 199 and quality > 99) then
		return "#CC3300"
	elseif(quality <= 299 and quality > 199) then
		return "#CC6600"
	elseif(quality <= 399 and quality > 299) then
		return "#CC9900"
	elseif(quality <= 499 and quality > 399) then
		return "#CCCC00"
	elseif(quality <= 599 and quality > 499) then
		return "#CCFF00"
	elseif(quality <= 699 and quality > 599) then
		return "#99CC00"
	elseif(quality <= 799 and quality > 699) then
		return "#99FF00"
	elseif(quality <= 899 and quality > 799) then
		return "#9966FF"
	elseif(quality <= 999 and quality > 899) then
		return "#9933FF"
	elseif(quality >= 1000) then
		return "#9900FF"
	end
end

function GetQuality(quality)
	local out = ""
	if(not quality or quality <= 99) then
		out = "отвратительное"
	elseif(quality <= 199 and quality > 99) then
		out = "мерзкое"
	elseif(quality <= 299 and quality > 199) then
		out = "гадкое"
	elseif(quality <= 399 and quality > 299) then
		out = "плохое"
	elseif(quality <= 499 and quality > 399) then
		out = "обычное"
	elseif(quality <= 599 and quality > 499) then
		out = "хорошее"
	elseif(quality <= 699 and quality > 599) then
		out = "очень хорошее"
	elseif(quality <= 799 and quality > 699) then
		out = "отличное"
	elseif(quality <= 899 and quality > 799) then
		out = "высокое"
	elseif(quality <= 999 and quality > 899) then
		out =  "великолепное"
	elseif(quality >= 1000) then
		out = "превосходное"
	end
	return GetQualityColor(quality)..out
end






