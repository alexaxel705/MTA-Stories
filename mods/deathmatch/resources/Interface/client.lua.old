			dxDrawText("Текущий ранг: "..getElementData(localPlayer, "job"), 1000*scalex, 875*scaley, 0, 0, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true)	
		else
			dxDrawText("Название: "..team, 1000*scalex, 840*scaley, 0, 0, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true)	
			local carrier = GetBandRang(team, getTeamVariable(team))
