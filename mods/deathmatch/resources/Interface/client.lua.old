			else
				setSoundVolume(VehicleTrack2, 0)
			end
			
			local x, y, z = getElementPosition(theVehicle)
			local i, d = getElementInterior(theVehicle), getElementDimension(theVehicle)
			setElementPosition(VehicleTrack, x, y, z)
			setElementInterior(VehicleTrack, i)
			setElementDimension(VehicleTrack, d)
			setElementPosition(VehicleTrack2, x, y, z)
			setElementInterior(VehicleTrack2, i)
			setElementDimension(VehicleTrack2, d)
		end
	end
	
	
	dxSetBlendMode("blend")
	dxSetRenderTarget()
	return RenderTargets["DrawSpeedo"][1]
end




function dxDrawCircleCustom( posX, posY, radius, width, angleAmount, startAngle, stopAngle, color, postGUI, text)
	if(startAngle == stopAngle) then
		return false
	end

	local function clamp( val, lower, upper )
		if ( lower > upper ) then lower, upper = upper, lower end
		return math.max( lower, math.min( upper, val ) )
	end

	radius = type( radius ) == "number" and radius or 50
	width = type( width ) == "number" and width or 5
	angleAmount = type( angleAmount ) == "number" and angleAmount or 1
	startAngle = clamp( type( startAngle ) == "number" and startAngle or 0, 0, 360 )
	stopAngle = clamp( type( stopAngle ) == "number" and stopAngle or 360, 0, 360 )
	color = color or tocolor( 255, 255, 255, 200 )
	postGUI = type( postGUI ) == "boolean" and postGUI or false

	if ( stopAngle < startAngle ) then
		local tempAngle = stopAngle
		stopAngle = startAngle
		startAngle = tempAngle
	end

	local n = 0
	for i = startAngle, stopAngle, angleAmount do
		local startX = math.cos( math.rad( i ) ) * ( radius - width )
		local startY = math.sin( math.rad( i ) ) * ( radius - width )
		local endX = math.cos( math.rad( i ) ) * ( radius + width )
		local endY = math.sin( math.rad( i ) ) * ( radius + width )
		dxDrawLine(startX + posX, startY + posY, endX + posX, endY + posY, color, width, postGUI)
		if(text) then
			dxDrawText(n, (startX/1.17)+posX,(startY/1.17)+posY, (startX/1.17)+posX,(startY/1.17)+posY, tocolor(160,160,160,255), scale/2, "default-bold", "center", "center")
			n=n+1
		end
	end
	return true
end









function getPositionFromElementOffset(element,offX,offY,offZ) 
    local m = getElementMatrix(element)
    local x = offX * m[1][1] + offY * m[2][1] + offZ * m[3][1] + m[4][1]
    local y = offX * m[1][2] + offY * m[2][2] + offZ * m[3][2] + m[4][2] 
    local z = offX * m[1][3] + offY * m[2][3] + offZ * m[3][3] + m[4][3] 
    return x, y, z
end 




function DrawSpeedoRender()
	if(not getElementData(localPlayer, "HUD")) then return false end
	
	local theVehicle = getPedOccupiedVehicle(localPlayer)
	if(theVehicle) then
		if(getPedOccupiedVehicleSeat(localPlayer) == 0) then
			dxDrawImage(screenWidth-RenderTargets["DrawSpeedo"][2], screenHeight-RenderTargets["DrawSpeedo"][3]-(155*scaley), RenderTargets["DrawSpeedo"][2], RenderTargets["DrawSpeedo"][3], DrawSpeedo(theVehicle), 0,0,0,tocolor(255,255,255,180))

			if(getDevelopmentMode()) then
				AddRage(15)
			end
		end
	end
end



function DrawExpText3D()
	for i, arr in pairs(PData['ExpText3D']) do
		if(not arr[5]) then 
			arr[5] = 0
			arr[6] = 255
		end
		local px,py,pz = getCameraMatrix()
		local dist = 50
		local distance = getDistanceBetweenPoints3D(arr[2],arr[3],arr[4],px,py,pz)

		if distance <= dist then
			sx,sy = getScreenFromWorldPosition(arr[2],arr[3],arr[4])
			if sx and sy then 
				MemText(arr[1], sx, sy, tocolor(255, 255, 255, arr[6]), scale, "pricedown", 1, 0, true, true, dist/(dist-distance))
			end
		end
		
		
		arr[4] = arr[4]+0.01
		arr[6] = arr[6]-1
		if(arr[6] <= 0) then
			table.remove(PData['ExpText3D'], i)
		end
	end
end
addEventHandler("onClientRender", root, DrawExpText3D)










function angle(theVehicle)
	local vx,vy,vz = getElementVelocity(theVehicle)
	local modV = math.sqrt(vx*vx + vy*vy)
	
	if not isVehicleOnGround(theVehicle) then return 0,modV end
	
	local rx,ry,rz = getElementRotation(theVehicle)
	local sn,cs = -math.sin(math.rad(rz)), math.cos(math.rad(rz))
	
	local deltaT = tick - (multTime or 0)
	if mult~= 1 and modV <= 0.3 and deltaT > 750 then
		mult = mult-1
		multTime = tick
	elseif deltaT > 1500 then
		local temp = 1
		if score >= 1000 then
			temp = 5
		elseif score >= 500 then
			temp = 4
		elseif score >= 250 then
			temp = 3
		elseif score >= 100 then
			temp = 2
		end
		if temp>mult then
			mult = temp
			multTime = tick
		end
	end
	

	local cosX = (sn*vx + cs*vy)/modV
	if cosX > 0.966 or cosX < 0 then return 0,modV end
	return math.deg(math.acos(cosX))*0.5, modV
end




function AddRage(count)
	if(count < 0) then
		count = count+(count*((1000-getPedStat(localPlayer, 160))/200))
	end
	local Rage = getElementData(localPlayer, "Rage")
	if(Rage+count < 0) then
		if(isTimer(RageTimer)) then killTimer(RageTimer) end
		triggerServerEvent("AccelerationDown", root, localPlayer)
		Rage = 0
		
	elseif(Rage + count > 1000) then
		Rage = 1000
	else
		Rage = Rage + count
	end
	setElementData(localPlayer, "Rage", Rage)
end









function AddInventoryItemNew(invname, item, posx, posy)
	local inv = false
	if(InitHud[invname]) then
		inv = InitHud[invname]
	else
		inv = PlayerInventory
	end
	local ItemSize = items[item["txd"]][10]
	
	if(not posx or not posy) then
		for sloty = 1, #inv[1] do
			local out = false
			for slotx = 1, #inv do
				if(table.empty(inv[slotx][sloty])) then
					local status = true
					local sizex, sizey = ItemSize[1]-1, ItemSize[2]-1
					for slot2x = slotx, slotx+sizex do
						for slot2y = sloty, sloty+sizey do
							if(inv[slot2x]) then
								if(inv[slot2x][slot2y]) then
									if(not table.empty(inv[slot2x][slot2y])) then
										status = false
									end
								else
									status = false
								end
							else
								status = false
							end
						end
					end
					
					if(status) then
						out = {slotx, sloty}
						break
					end
				end
			end
			if(out) then
				posx, posy = out[1], out[2]
				break
			end
		end
	else
		if(table.empty(inv[posx][posy])) then
			local sizex, sizey = ItemSize[1]-1, ItemSize[2]-1
			for slot2x = posx, posx+sizex do
				for slot2y = posy, posy+sizey do
				
					if(not inv[slot2x]) then
						return false
					end
					
					if(not inv[slot2x][slot2y]) then
						return false
					end
					
					if(not table.empty(inv[slot2x][slot2y])) then
						return false
					end
				end
			end
		else
			return false
		end
	end
	
	if(posx and posy) then
		inv[posx][posy] = item
		
		local sizex, sizey = ItemSize[1]-1, ItemSize[2]-1
		for slot2x = posx, posx+sizex do
			for slot2y = posy, posy+sizey do
				if(table.empty(inv[slot2x][slot2y])) then
					inv[slot2x][slot2y]["link"] = {posx, posy}
				end
			end
		end
		
		if(invname == "Инвентарь") then
			triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
		end
		return true
	else
		triggerServerEvent("ToolTip", localPlayer, localPlayer, "Кончилось место в инвентаре!")
		return false
	end
	
end
addEvent("AddInventoryItemNew", true)
addEventHandler("AddInventoryItemNew", localPlayer, AddInventoryItemNew)



function Nitro(state)
	local theVehicle = getPedOccupiedVehicle(localPlayer)
	if(theVehicle) then
		if(state) then
			setVehicleNitroActivated(theVehicle, true)
		else
			setVehicleNitroActivated(theVehicle, false)
		end
	end
end
addEvent("Nitro", true)
addEventHandler("Nitro", localPlayer, Nitro)





function FoundStackedInventoryItem(item)
	local id = false
	for x, dat in pairs(PlayerInventory) do
		for y, data in pairs(dat) do
			if(data["name"]) then
				if(data["name"] == item["name"]) then
					if(GetItemQuality(data) == GetItemQuality(item)) then
						if(items[item["name"]][3] > GetItemCount(data)) then
							id={x,y}
							break
						end
					end
				end
			end
		end
	end
	return id
end


 
function FoundFullStackedInventoryItem(item)
	local id = false
	for x, dat in pairs(PlayerInventory) do
		for y, data in pairs(dat) do
			if(data["name"]) then
				if(data["name"] == item["name"]) then
					if(items[item["name"]][3] == GetItemCount(data)) then
						if(GetItemQuality(data) == GetItemQuality(item)) then
							id={x,y}
							break
						end
					end
				end
			end
		end
	end
	return id
end
 





function RemoveInventoryItem(invname, x,y)
	local sizex, sizey
	if(invname == "Инвентарь") then
		sizex, sizey = items[PlayerInventory[x][y]["txd"]][10][1]-1, items[PlayerInventory[x][y]["txd"]][10][2]-1
	else
		sizex, sizey = items[InitHud[invname][x][y]["txd"]][10][1]-1, items[InitHud[invname][x][y]["txd"]][10][2]-1
	end
	for slot2x = x, x+sizex do
		for slot2y = y, y+sizey do
			if(invname == "Инвентарь") then
				PlayerInventory[slot2x][slot2y] = {}
			else
				InitHud[invname][slot2x][slot2y] = {}
			end
		end
	end
	if(invname == "Инвентарь") then
		triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
	end
	return true
end
addEvent("RemoveInventoryItem", true)
addEventHandler("RemoveInventoryItem", localPlayer, RemoveInventoryItem)


function RemoveInventoryItemCount(x,y)
	local arr = InitHud["Инвентарь"] or PlayerInventory
	if(GetItemCount(arr[x][y])-1 == 0) then
		RemoveInventoryItem("Инвентарь", x,y)
	else
		arr[x][y]["count"] = GetItemCount(arr[x][y])-1
		triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(arr))
	end
	return true
end
addEvent("RemoveInventoryItemCount", true)
addEventHandler("RemoveInventoryItemCount", localPlayer, RemoveInventoryItemCount)





