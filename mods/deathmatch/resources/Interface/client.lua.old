function RGBToHex(red, green, blue, alpha)
	if((red < 0 or red > 255 or green < 0 or green > 255 or blue < 0 or blue > 255) or (alpha and (alpha < 0 or alpha > 255))) then return nil end
	if(alpha) then return string.format("#%.2X%.2X%.2X%.2X", red,green,blue,alpha)
	else return string.format("#%.2X%.2X%.2X", red,green,blue) end
end


function PedDamage(attacker, weapon, bodypart, loss)
	if(BannedReasons[weapon]) then 
		cancelEvent()
	end
	if(attacker) then
		if(getElementType(attacker) == "vehicle") then
			if(getElementModel(attacker) == 532) then
				bodypart = 9
				weapon = 160
			end
			attacker = getVehicleOccupant(attacker)
		end
		
		if(attacker == localPlayer) then
			local color = RGBToHex(255, 255, 0)
			if(weapon) then
				local usedslot = GetUsableSlot()
				if(usedslot) then
					local dam = GetDamageItem(PlayerInventory[usedslot[1]][usedslot[2]])
					loss = math.random(dam[1], dam[2])
				end
			end
			loss = math.round(loss, 0)
			triggerServerEvent("PedDamage", attacker, source, weapon, bodypart, loss)

			for _, thePed in pairs(getElementsByType("ped", root, true)) do
				if(source ~= thePed) then
					local team = getElementData(thePed, "team")
					if(team) then
						if(getTeamName(getTeamFromName(team)) ~= "Мирные жители") then
							triggerServerEvent("PedDamage", attacker, thePed, weapon, 0, 0)
						end
					end
				end
			end
			cancelEvent()	
		elseif(getElementType(attacker) == "ped") then
			if(isElementSyncer(source)) then
				triggerServerEvent("PedDamage", attacker, source, weapon, bodypart, loss)
			end
		end
	end
end
addEventHandler("onClientPedDamage", root, PedDamage)






function AddInventoryItem(invname, item, posx,posy)
	local inv = false
	if(InitHud[invname]) then
		inv = InitHud[invname]
	else
		inv = PlayerInventory
	end


	if(posx and posy) then
		local status = true

		local ItemSize = items[item["txd"]][10]	
		local sizex, sizey = ItemSize[1]-1, ItemSize[2]-1
		for slot2x = posx, posx+sizex do
			for slot2y = posy, posy+sizey do
				if(not table.empty(inv[slot2x][slot2y])) then
					status = false
				end
			end
		end
		
		
		if(status) then
			AddInventoryItemNew(invname, item, posx,posy)
			return true
		end
	end


	local stacked = false
	local count = GetItemCount(item)
	local quality = GetItemQuality(item)
	if count > 0 then 
		stacked = math.floor(count/items[item["txd"]][3])
		if(item["txd"] ~= "Деньги") then
			InformTitle("В #4682B4инвентарь#FFFFFF добавлен предмет "..COLOR["KEY"]["HEX"]..item["txd"].."#FFFFFF, нажми #C00000i#FFFFFF чтобы посмотреть")
		end
	else
		stacked = math.ceil(count/items[item["txd"]][3])
	end
	
	if(stacked >= 1) then
		for v = 1, stacked do
			local buff = table.copy(item) -- Костыль чтобы не было багов
			buff["count"] = items[item["txd"]][3]
			AddInventoryItemNew(invname, buff)
			count = count - items[item["txd"]][3]
		end
	elseif(stacked <= -1) then
		for v = 1, stacked-stacked-stacked do
			local nc = FoundFullStackedInventoryItem(item)
			if(nc) then
				RemoveInventoryItem(invname, nc[1], nc[2])
				count = count + items[item["txd"]][3]
			end
		end
	end
	
	
	if(count == 0) then
		if(invname == "Инвентарь") then
			triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
		end
		return true
	elseif(count > 0) then
		local nc = FoundStackedInventoryItem(item)
		if(nc) then
			if(GetItemCount(PlayerInventory[nc[1]][nc[2]])+count <= items[item["txd"]][3]) then
				PlayerInventory[nc[1]][nc[2]]["count"] = GetItemCount(PlayerInventory[nc[1]][nc[2]])+count
				count = 0
			else
				count = count - (items[item["txd"]][3]-PlayerInventory[nc[1]][nc[2]]["count"])
				PlayerInventory[nc[1]][nc[2]]["count"] = items[item["txd"]][3]
			end	
		end
	
		if(count > 0) then
			item["count"] = count
			AddInventoryItemNew(invname, item) --Докладываем остаток
		end
		
		if(invname == "Инвентарь") then
			triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
		end
		return true
	elseif(count < 0) then
		local nc = FoundStackedInventoryItem(item)
		if(not nc) then nc = FoundFullStackedInventoryItem(item) end
		if(nc) then
			if(GetItemCount(PlayerInventory[nc[1]][nc[2]])+count <= 0) then
				RemoveInventoryItem(invname, nc[1], nc[2])
			else
				PlayerInventory[nc[1]][nc[2]]["count"] = GetItemCount(PlayerInventory[nc[1]][nc[2]])+count
			end
			if(invname == "Инвентарь") then
				triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
			end
			return true
		end
	end
end
addEvent("AddInventoryItem", true)
addEventHandler("AddInventoryItem", localPlayer, AddInventoryItem)





