function dxDrawBorderedText(text, left, top, right, bottom, color, scale, font, alignX, alignY, clip, wordBreak, postGUI, colorCoded, subPixelPositioning)
	if(text) then
		local r,g,b = bitExtract(color, 0, 8), bitExtract(color, 8, 8), bitExtract(color, 16, 8)
		if(r+g+b >= 100) then r = 0 g = 0 b = 0 else r = 255 g = 255 b = 255 end
		local textb = string.gsub(text, "#%x%x%x%x%x%x", "")
		local locsca = math.round(scale, 0)
		if (locsca == 0) then locsca = 1 end
		for oX = -locsca, locsca do 
			for oY = -locsca, locsca do 
				dxDrawText(textb, left + oX, top + oY, right + oX, bottom + oY, tocolor(r, g, b, bitExtract(color, 24, 8)), scale, font, alignX, alignY, clip, wordBreak,postGUI,false, subPixelPositioning)
			end
		end

		dxDrawText(text, left, top, right, bottom, color, scale, font, alignX, alignY, clip, wordBreak, postGUI, colorCoded, subPixelPositioning)
	end
end



function dxDrawTextMoney(text, left, top, right, bottom, color, scale, font, alignX, alignY, clip, wordBreak, postGUI, colorCoded, subPixelPositioning)
	if(text) then
		local r,g,b = bitExtract(color, 0, 8), bitExtract(color, 8, 8), bitExtract(color, 16, 8)
		if(r+g+b >= 100) then r = 0 g = 0 b = 0 else r = 255 g = 255 b = 255 end
		local textb = string.gsub(text, "#%x%x%x%x%x%x", "")
		local locsca = math.round(scale*2, 0)
		if (locsca == 0) then locsca = 2 end
		for oX = -locsca, locsca do 
			for oY = -locsca, locsca do 
				dxDrawText(textb, left + oX, top + oY, right + oX, bottom + oY, tocolor(r, g, b, bitExtract(color, 24, 8)), scale, font, alignX, alignY, clip, wordBreak,postGUI,false, subPixelPositioning)
			end
		end

		dxDrawText(text, left, top, right, bottom, color, scale, font, alignX, alignY, clip, wordBreak, postGUI, colorCoded, subPixelPositioning)
	end
end



function table.copy(t)
	local t2 = {};
	for k,v in pairs(t) do
		if type(v) == "table" then
			t2[k] = table.copy(v);
		else
			t2[k] = v;
		end
	end
	return t2;
end





function table.empty(self)
    for _, _ in pairs(self) do
        return false
    end
    return true
end





function InformTitle(text, types)
	if(types) then
		if(types == "wardrobe") then
			AddITimerText = "В #4682B4гардероб#FFFFFF добавлен костюм "..text
		end
	else
		AddITimerText = text
	end
	
		
	if(isTimer(AddITimer)) then
		resetTimer(AddITimer)
	else
		addEventHandler("onClientHUDRender", root, DrawInformTitle)
		
		AddITimer = setTimer(function() removeEventHandler("onClientHUDRender", root, DrawInformTitle) end, 3500, 1)
	end
end
addEvent("InformTitle", true)
addEventHandler("InformTitle", localPlayer, InformTitle)



function DrawInformTitle()
	dxDrawBorderedText(AddITimerText, 22*scale, screenHeight-(30*scale), screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "sans", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
end




function DrawExpText()
	for i, arr in pairs(PData['ExpText']) do
		if(not arr[4]) then 
			arr[4] = 0
			arr[5] = 255
		end
		
		font = "sans"
		tw = dxGetTextWidth(arr[1], scale, font, true)
		th = dxGetFontHeight(scale, font)

		dxDrawBorderedText(arr[1], (arr[2]-tw/2), (arr[3]-th/2)+arr[4], screenWidth, screenHeight, tocolor(0, 255, 153, 180), scale, font, "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
		
		arr[4] = arr[4]-0.3
		arr[5] = arr[5]-1
		if(arr[5] <= 0) then
			table.remove(PData['ExpText'], i)
		end
	end
end
addEventHandler("onClientRender", root, DrawExpText)






--[[
	scale3D - Необходимо для того чтобы уменьшать текст в 3D пространстве, без перерисовки
--]]
function MemText(text, left, top, color, scale, font, border, incline, centerX, centerY, scale3D)
	if(text) then
		local w,h = dxGetTextWidth(text, scale, font, true)+(border*2), dxGetFontHeight(scale, font)+(border*2)
		local index = text..color
		
		if(not VideoMemory["HUD"][index]) then
			VideoMemory["HUD"][index] = dxCreateRenderTarget(w+((w*incline)/4),h, true)
			dxSetRenderTarget(VideoMemory["HUD"][index], true)
			dxSetBlendMode("modulate_add")
			
			local posx, posy = ((w*incline)/4),0
			if(border) then
				posx = posx+border
				posy = posy+border
			end
			
			
			local textb = string.gsub(text, "#%x%x%x%x%x%x", "")
			for oX = -border, border do 
				for oY = -border, border do 
					dxDrawText(textb, posx+oX, posy+oY, 0+oX, 0+oY, tocolor(0, 0, 0, 255), scale, font, "left", "top", false, false,false,false,true)
				end
			end

			dxDrawText(text, posx, posy, 0, 0, color, scale, font, "left", "top", false,false,false,true,true)

			dxSetBlendMode("blend")
			dxSetRenderTarget()
			
			if(incline > 0) then 
				local pixels = dxGetTexturePixels(VideoMemory["HUD"][index])
				local x, y = dxGetPixelsSize(pixels)
				local texture = dxCreateTexture(x,y, "argb")
				local pixels2 = dxGetTexturePixels(texture)
				local pady = 0
				for y2 = 0, y-1 do
					for x2 = 0, x-1 do
						local colors = {dxGetPixelColor(pixels, x2,y2)}
						if(colors[4] > 0) then
							dxSetPixelColor(pixels2, x2-pady, y2, colors[1],colors[2],colors[3],colors[4])
						end
					end
					pady = pady+incline
				end
				
				dxSetTexturePixels(texture, pixels2)
				VideoMemory["HUD"][index] = texture
			end
		end
		
		if(scale3D) then 
			w = w/scale3D 
			h = h/scale3D
		end
		if(centerX) then 
			if(centerX == "right") then 
				left = left-(w) 
			else
				left = left-(w/2) 
			end
		end
		
		if(centerY) then 
			if(centerY == "bottom") then 
				top = top-(h) 
			else
				top = top-(h/2)
			end
		end
		
		return dxDrawImage(left,top, w,h, VideoMemory["HUD"][index], 0, 0, 0, color) 
	end
end


local score = 0
local tick
local idleTime
local multTime
local mult = 1


local VehicleSpeed = 0
local SlowTahometer = 0
local ClearDriving = false
setElementData(localPlayer, "Rage", 0)
local RageTimer = false
local Driver = false

addEvent("driftCarCrashed", true)
addEventHandler("driftCarCrashed", root, function()
	resetTimer(ClearDriving)
	if score ~= 0 then
		score = 0
		mult = 1
	end
end)

--Для работы дальнобойщиком без прицепа





function ClientVehicleEnter(thePlayer, seat)
	if(thePlayer == localPlayer) then
		for i = 1, 44 do -- Для пассажиров
			setWorldSoundEnabled(i, true)
		end
		
		if(seat == 0) then
			local theVehicle = getPedOccupiedVehicle(thePlayer)
			
			if(isElement(VehicleTrack)) then
				destroyElement(VehicleTrack)
				destroyElement(VehicleTrack2)
			end
			
			if(getElementType(theVehicle) == "vehicle" or getElementType(theVehicle) == "bike") then
				local x,y,z = getElementPosition(theVehicle)
				VehicleTrack = playSFX3D("genrl", VehicleSound[getElementModel(theVehicle)], 0, x,y,z, true)
				VehicleTrack2 = playSFX3D("genrl", VehicleSound[getElementModel(theVehicle)], 1, x,y,z, true)
				
				setSoundVolume(VehicleTrack, 0)
				setSoundVolume(VehicleTrack2, 0)
				setSoundMaxDistance(VehicleTrack, 50)
				setSoundMaxDistance(VehicleTrack2, 50)
				
				for i = 7, 16 do
					setWorldSoundEnabled(i, false)
				end
				setWorldSoundEnabled(40, false)
			end
			
			setVehicleNitroCount(theVehicle, 0)
			Driver = {
				["Handling"] = getVehicleHandling(theVehicle),
				["Distance"] = 0
			}
			Driver["drx"], Driver["dry"], Driver["drz"] = getElementPosition(theVehicle)
			local name = getElementData(theVehicle, "name") or getVehicleName(theVehicle)
			if(getElementData(theVehicle, "name")) then
				name = getElementData(theVehicle, "name")
			end
			if(getElementData(theVehicle, "year")) then
				name = name.." "..getElementData(theVehicle, "year")
			end
			if(getElementData(localPlayer, "City")) then
				triggerEvent("SetZoneDisplay", localPlayer, "#9b7c52"..name)
			else
				triggerEvent("SetZoneDisplay", localPlayer, "#66935C"..name)
			end
		
			ClearDriving = setTimer(function() 
				AddRage(150)
				--triggerEvent("helpmessageEvent", localPlayer, "#ffe800Чистое вождение +150")
			end, 25000, 0)

			if(getElementModel(theVehicle) == 532 or getElementModel(theVehicle) == 531) then
				onAttach(theVehicle)
			end
			if(getElementData(theVehicle, "type")) then
				if(getElementData(theVehicle, "type") == "jobtruck") then
					triggerEvent("onClientTrailerAttach", theVehicle)
				end
			end
			
			addEventHandler("onClientHUDRender", root, DrawSpeedoRender)
		end
	end
end
addEventHandler("onClientVehicleEnter", root, ClientVehicleEnter)



function ClientVehicleExit(thePlayer, seat)
	if(thePlayer == localPlayer) then
		if(seat == 0) then
			Driver = false
			killTimer(ClearDriving)
			if(getElementModel(source) == 532 or getElementModel(source) == 531) then
				deAttach(source)
			end
			if(getElementData(source, "type")) then
				if(getElementData(source, "type") == "jobtruck") then
					triggerEvent("onClientTrailerDetach", source, source)
				end
			end
			
		end
	end
end
addEventHandler("onClientVehicleExit", root, ClientVehicleExit)


function ClientVehicleStartExit(thePlayer, seat)
	if(thePlayer == localPlayer) then
		if(seat == 0) then
			removeEventHandler("onClientHUDRender", root, DrawSpeedoRender)
			destroyElement(VehicleTrack2)
			destroyElement(VehicleTrack)
		end
	end
end
addEventHandler("onClientVehicleStartExit", root, ClientVehicleStartExit)





function checkKey()
	local theVehicle = getPedOccupiedVehicle(localPlayer)
	if(theVehicle and ClearDriving) then
		if(VehicleSpeed < 1) then
			if(isTimer(ClearDriving)) then resetTimer(ClearDriving) end
			if(getElementData(theVehicle, "owner") == getPlayerName(localPlayer)) then
				if(not ParkMessage) then
					ToolTip("Нажми P чтобы припарковать машину")
					ParkMessage = true
				end
			end
		end
	end
end
setTimer(checkKey,700,0)



function updateFPS(msSinceLastFrame)
    fps = (1/msSinceLastFrame) * 1000
	
	if(getDevelopmentMode()) then
		local roundedFPS = math.floor(fps)
		dxDrawBorderedText(roundedFPS, dxGetTextWidth(roundedFPS), 0, 0, 0, tocolor(200, 200, 200, 255), scale*2, "default-bold", "left", "top")
	end
	if(FPSMessage) then
		if(fps < 30) then
			FPSMessage = FPSMessage+1
		else
			FPSMessage = 0
		end
		
		if(FPSMessage > 30) then
			ToolTip("Используй клавишу F9 чтобы\r\nВключить режим для слабых ПК")
			FPSMessage = false
		end
	end

	if(getElementModel(localPlayer) == 299) then
		if(isPedDoingTask(localPlayer, "TASK_COMPLEX_IN_WATER")) then
			setElementHealth(localPlayer, getElementHealth(localPlayer)-0.5)
		end
	end
end
addEventHandler("onClientPreRender", root, updateFPS)







function getVehicleOneGear(engineAcceleration, dragCoeff, numberOfGears) -- engineAcceleration, dragCoeff, numberOfGears
	return (math.sqrt(3300*engineAcceleration/dragCoeff)*1.18)/numberOfGears
end


function getVehicleGear(theVehicle, engineAcceleration, dragCoeff, numberOfGears)
	local onegear = getVehicleOneGear(engineAcceleration, dragCoeff, numberOfGears)
	local result = 0
	for Gear = 0, numberOfGears, 1 do
		if(getVehicleCurrentGear(theVehicle) > 0) then
			if(onegear*Gear <= VehicleSpeed) then
				if((Gear+1) <= numberOfGears) then
					result = (Gear+1)
				end
			end
		else
			result = 0
		end
	end
    return result
end




function TuningExits()
	local theVehicle = getPedOccupiedVehicle(localPlayer)
	Driver["Handling"] = getVehicleHandling(theVehicle)
end
addEvent("TuningExits", true)
addEventHandler("TuningExits", localPlayer, TuningExits)




local WheelStates = {
	["rwd"] = {1, 3}, 
	["awd"] = {0,1,2,3}, 
	["fwd"] = {0,2}
}

function getVehicleRPM(theVehicle, engineAcceleration, dragCoeff, numberOfGears)
	local onegear = getVehicleOneGear(engineAcceleration, dragCoeff, numberOfGears)
	local MaxRPM = GetVehicleMaxRPM(engineAcceleration)
	local Gear = getElementData(localPlayer, "ManualGear") or getVehicleGear(theVehicle, engineAcceleration, dragCoeff, numberOfGears)
	local crpm = 0
	local GroundGrip = true
	if(getVehicleType(theVehicle) == "Automobile") then
		local HT = getVehicleHandling(theVehicle) 
		for _, wheel in pairs(WheelStates[HT["driveType"]]) do
			if(not isVehicleWheelOnGround(theVehicle, wheel)) then
				GroundGrip = false
			end
		end
	end
	if(getPedControlState(localPlayer, "accelerate") and getPedControlState(localPlayer, "brake_reverse") or 
	getPedControlState(localPlayer, "accelerate") and getPedControlState(localPlayer, "handbrake") or
	not GroundGrip and getPedControlState(localPlayer, "accelerate") or getPedControlState(localPlayer, "brake_reverse")) then
		crpm = MaxRPM
	else
		if(Gear > 0) then
			crpm = MaxRPM/onegear*(onegear-((onegear*Gear)-VehicleSpeed))
		else
			crpm = MaxRPM/onegear*((VehicleSpeed-onegear*Gear))
		end
	end
	if getVehicleEngineState(theVehicle) == true then
		if(crpm < 800) then 
			crpm = 800
		else
			if(crpm > MaxRPM) then crpm = MaxRPM end -- Костыль
		end
	end
    return crpm
end


function GetVehicleMaxRPM(engineAcceleration)
	return (((10*(engineAcceleration))*1.5))*40
end





function DrawSpeedo(theVehicle)
	dxSetRenderTarget(RenderTargets["DrawSpeedo"][1], true)
	dxSetBlendMode("modulate_add")
	
	local scale = scale*RenderQuality
	local x = RenderTargets["DrawSpeedo"][2]*RenderQuality
	local y = RenderTargets["DrawSpeedo"][3]*RenderQuality
	local scalex = scalex*RenderQuality
	local scaley = scaley*RenderQuality
	

	local vx, vy, vz = getElementVelocity(theVehicle)
	VehicleSpeed = (vx^2 + vy^2 + vz^2)^(0.5)*156


	
	tick = getTickCount()
	local angulo,velocidad = angle(theVehicle)
	
	local tempBool = tick - (idleTime or 0) < 750
	if not tempBool and score ~= 0 then
		score = 0
	end
	
	if angulo ~= 0 then
		if tempBool then
			score = score + math.floor(angulo*velocidad)*mult
		else
			score = math.floor(angulo*velocidad)*mult
		end

		idleTime = tick
	end
	

	if tick - (idleTime or 0) < 50 then
		if(score > 500) then
			AddRage(1)
			--triggerEvent("helpmessageEvent", localPlayer, "#ffe800Дрифт +"..math.round(score/100, 0))
		end
	end


	local MaxRPM = GetVehicleMaxRPM(Driver["Handling"]["engineAcceleration"])
	local RPMMeter = false
	local RPMDate = false 
	
	
	
	if(MaxRPM <= 4000) then
		RPMMeter = 45
		RPMDate = 4000
	elseif(MaxRPM > 4000 and MaxRPM <= 6000) then
		RPMMeter = 37.5
		RPMDate = 6000
	elseif(MaxRPM > 6000 and MaxRPM <= 7000) then
		RPMMeter = 32.1
		RPMDate = 7000
	elseif(MaxRPM > 7000 and MaxRPM <= 8000) then
		RPMMeter = 28
		RPMDate = 8000
	elseif(MaxRPM > 8000 and MaxRPM <= 10000) then
		RPMMeter = 22.5
		RPMDate = 10000
	elseif(MaxRPM > 10000 and MaxRPM <= 12000) then
		RPMMeter = 18.7
		RPMDate = 12000
	elseif(MaxRPM > 12000 and MaxRPM <= 14000) then
		RPMMeter = 16
		RPMDate = 14000
	elseif(MaxRPM > 14000 and MaxRPM <= 16000) then
		RPMMeter = 14
		RPMDate = 16000
	elseif(MaxRPM > 16000 and MaxRPM <= 18000) then
		RPMMeter = 12.5
		RPMDate = 18000
	elseif(MaxRPM > 18000 and MaxRPM <= 20000) then
		RPMMeter = 11.2
		RPMDate = 20000
	end
	
	
	
	--if(RPMDate) then
	--	local RPM = (225*(getVehicleRPM(theVehicle, Driver["Handling"]["engineAcceleration"], Driver["Handling"]["dragCoeff"], Driver["Handling"]["numberOfGears"])/RPMDate))
	--	local RedRPMZone = 225*((MaxRPM/RPMDate))
	--	if(SlowTahometer < RPM) then
	--		SlowTahometer = SlowTahometer+(RPM-SlowTahometer)/20
	--	elseif(SlowTahometer > RPM) then
	--		SlowTahometer = SlowTahometer-(SlowTahometer-RPM)/20
	--	end
	--	sx = (150*scalex)
	--	sy = (210*scaley)
	--
	--	dxDrawCircle(sx,sy, 54*scale, 0, 360, tocolor(0,0,0,50))
	--	dxDrawCircleCustom(sx,sy, 50*scale, 2.5*scale, 4, 120, 120+RedRPMZone, tocolor(0,0,0,200))
	--	dxDrawCircleCustom(sx,sy, 50*scale, 2.5*scale, 4, 120+RedRPMZone, 345, tocolor(255,51,51,200))
	--	dxDrawCircleCustom(sx,sy, 50*scale, 2.5*scale, 4, 120, 120+math.floor(SlowTahometer), tocolor(255,255,255,255))
	--	if(getVehicleNitroCount(theVehicle)) then
	--		dxDrawCircleCustom(sx,sy, 60*scale, 4*scale, 1, 59, 158, tocolor(0,0,0,20))
	--		dxDrawCircleCustom(sx,sy, 60*scale, 2*scale, 4, 60, 157, tocolor(100,100,100,200))
	--		dxDrawCircleCustom(sx,sy, 60*scale, 2*scale, 4, 60, 120+(3.7*getVehicleNitroCount(theVehicle)), tocolor(40,200,255,160))
	--	end
	--
	--	dxDrawCircleCustom(sx,sy, 60*scale, 4*scale, 1, 158, 345, tocolor(0,0,0,20))
	--	dxDrawCircleCustom(sx,sy, 60*scale, 2*scale, 4, 160, 344, tocolor(100,100,100,200))
	--	dxDrawCircleCustom(sx,sy, 60*scale, 2*scale, 4, 160, 160+(184*(getElementData(localPlayer, "Rage")/1000)), tocolor(255,200,40,160))
	--
	--	dxDrawCircleCustom(sx,sy, 44*scale, 1*scale, RPMMeter, 120, 345, tocolor(255,255,255,255), nil, true)
	--	dxDrawCircleCustom(sx,sy, 43*scale, 0.5*scale, 0.8, 120, 345, tocolor(255,255,255,255))
