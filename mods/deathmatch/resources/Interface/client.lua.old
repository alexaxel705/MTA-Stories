			local DrawSpeed = string.format("%03.f",VehicleSpeed)
			
			local speedsize = 35*scale
			local speedoff = 19.5*scale
			dxDrawImage(x-(270*scalex),y-(135*scaley), speedsize, speedsize, Pricedown[string.sub(DrawSpeed, 1, 1)], 0,0,0,tocolor(210,210,210,255))
			dxDrawImage(x-(270*scalex)+speedoff,y-(135*scaley), speedsize, speedsize, Pricedown[string.sub(DrawSpeed, 2, 2)], 0,0,0,tocolor(210,210,210,255))
			dxDrawImage(x-(270*scalex)+(speedoff*2),y-(135*scaley), speedsize, speedsize, Pricedown[string.sub(DrawSpeed, 3, 3)], 0,0,0,tocolor(210,210,210,255))
			
			dxDrawBorderedText("КМ/Ч", 0,y-(128*scaley),x-(100*scalex),0, tocolor(150,150,150,255), scale/1.5, "default-bold", "right")
