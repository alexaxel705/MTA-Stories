				setSoundVolume(VehicleTrack, (0.15+(SlowTahometer/RPMDate)/2))
			end
			
			setSoundSpeed(VehicleTrack2, 1+((SlowTahometer/RPMDate)/2))
			
			if(getVehicleEngineState(theVehicle)) then
