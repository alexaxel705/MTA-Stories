function GetRangStats()
	local count = 0
	count = count+(math.round(exports["statistic"]:GetStats(3)/1000))
	count = count+(math.round(exports["statistic"]:GetStats(4)/1000))
	
	
	local rang = RangsStats[1][2]
	for slot = 1, #RangsStats do
		if(count >= RangsStats[slot][1]) then
			rang = RangsStats[slot][2]
		end
	end
	return rang.."\n"..count
end



function DrawMainMenu()
	dxDrawRectangle(0, 0, screenWidth, screenHeight, tocolor(0,0,0,255))	
	dxDrawText(MenuAction,25*scale, 25*scale, 25*scale, 25*scale, tocolor(180,200,210, 255), scale, "pricedown", "left", "top", false, false, false, true)	

	local out = ""
	for slot = 0, #MenuList do
		local color = "#495B6C"
		if(MenuSelect == slot) then
			color = "#BBD7FA"
		end
		out = out..color..MenuList[slot].."\r\n"
	end		
	
	local text = ""
	
	if(MenuAction == "СТАТИСТИКА") then
		if(MenuList[MenuSelect] == "ИГРОК") then
			text = "Расстояние пешком\n"..math.round(exports["statistic"]:GetStats(3)).." ft.\n\n"..
			"Расстояние на автомобиле\n"..math.round(exports["statistic"]:GetStats(4)).." ft.\n\n"
		end
	elseif(MenuAction == "ИТОГИ") then
		if(MenuList[MenuSelect] == "ИГРОК") then
			text = "В разработке"
		end
	end
	
	if(text ~= "") then
		dxDrawText(GetRangStats(), screenWidth/2, screenHeight/4.8, screenWidth/2, screenHeight/4.8, tocolor(255, 255, 255, 255), scale*1.5, "default-bold", "Center", "top", false, false, false, true)	

		dxDrawText(out, 50*scale, screenHeight/2.8, 50*scale, screenHeight/2.8, tocolor(255, 255, 255, 255), scale*2, "default", "Left", "top", false, false, false, true)
		
		dxDrawText(text, screenWidth/2, screenHeight/2.8, screenWidth/2, screenHeight/2.8, tocolor(255, 255, 255, 255), scale*1.5, "default", "Center", "top", false, false, false, true)	
	else
		dxDrawText(out, screenWidth/2, screenHeight/2.8, screenWidth/2, screenHeight/2.8, tocolor(255, 255, 255, 255), scale*2, "default", "Center", "top", false, false, false, true)	
	end
end

function MainMenuEvent()
	if(MainMenu) then
		MainMenu = false
		removeEventHandler("onClientHUDRender", root, DrawMainMenu)
		triggerEvent("SetPlayerHudComponentVisible", localPlayer, "all", true)
	else
		playSFX("genrl", 53, 6, false)
		MenuList = {
			[0] = "ПРОДОЛЖИТЬ",
			[1] = "КАРТА", 
			[2] = "СТАТИСТИКА", 
			[3] = "ИТОГИ",
			[4] = "ОПЦИИ",
			[5] = "ВЫХОД"
		}
		MenuAction = "Multi Theft Auto: Stories"
		MainMenu = true
		MenuSelect = 0
		addEventHandler("onClientHUDRender", root, DrawMainMenu)
		triggerEvent("SetPlayerHudComponentVisible", localPlayer, "all", false)
	end
end

function playerPressedKey(button, press)
	if(getPedOccupiedVehicle(localPlayer)) then
		if(getPedOccupiedVehicleSeat(localPlayer) == 0) then
			if(button == "lshift") then
				local Rage = getElementData(localPlayer, "Rage")
				if(Rage > 0) then
					if(press) then
						AddRage(-2)
						RageTimer = setTimer(function() 
							AddRage(-2)
						end, 50, 0)
						triggerServerEvent("Acceleration", localPlayer, localPlayer)
					else
						killTimer(RageTimer)
						triggerServerEvent("AccelerationDown", localPlayer, localPlayer)
					end
				end
			end
		end
	end
	
	if(MainMenu) then
		if(press) then
			if(button == "arrow_u" or button == "w") then
				playSFX("genrl", 53, 4, false)
				if(MenuSelect-1 < 0) then
					MenuSelect = #MenuList
				else
					MenuSelect = MenuSelect-1
				end
			elseif(button == "arrow_d" or button == "s") then
				playSFX("genrl", 53, 5, false)
				if(MenuSelect >= #MenuList) then
					MenuSelect = 0
				else
					MenuSelect = MenuSelect+1
				end
			elseif(button == "enter" or button == "e") then
				playSFX("genrl", 53, 6, false)
				local Action = MenuList[MenuSelect]
				MenuAction = Action
				
				if(Action == "ВЫХОД") then
					triggerServerEvent("kickme", localPlayer, localPlayer)
				elseif(Action == "ПРОДОЛЖИТЬ") then
					MainMenuEvent()
				elseif(Action == "КАРТА") then
					triggerEvent("ResourceMap", localPlayer, localPlayer)
					MainMenuEvent()
				elseif(Action == "ОПЦИИ") then
					MenuSelect = 0
					MenuList = {
						[0] = "СМЕНИТЬ ПАРОЛЬ"
					}
				elseif(Action == "СМЕНИТЬ ПАРОЛЬ") then
					MainMenuEvent()
					triggerEvent("CreateButtonInputInt", localPlayer, "ChangePass", "Введи новый пароль")				
				elseif(Action == "ИТОГИ") then
					MenuSelect = 0
					MenuList = {
						[0] = "ИГРОК",
					}
				elseif(Action == "СТАТИСТИКА") then
					MenuSelect = 0
					MenuList = {
						[0] = "ИГРОК",
					}
				end
				cancelEvent()
			elseif(button == "backspace") then
				MainMenuEvent()
				cancelEvent()
			end
		end
	end

	if(press) then
		if(button == "escape") then
			for name, _ in pairs(InitHud) do
				InitInterface(name)
				if(name == "Багажник") then
					triggerServerEvent("TrunkClose", localPlayer, localPlayer)
				end
				cancelEvent()
				return
			end
			
			if(getElementData(localPlayer, "ResourceMap")) then
				triggerEvent("ResourceMap", localPlayer, localPlayer)
				
				cancelEvent()
				return
			end
			
			if(not getElementData(localPlayer, "chat")) then
				MainMenuEvent()
				cancelEvent()
				return
			end
		elseif(tonumber(button)) then
			if(not getElementData(localPlayer, "chat")) then
				UseBind(tonumber(button))
			end
		elseif(button == "mouse1") then
			if(not isCursorShowing()) then
				local usableslot = GetUsableSlot()
				if(usableslot) then
					if(PlayerInventory[usableslot[1]][usableslot[2]]["txd"] == "Удочка") then
						if(getElementData(localPlayer, "fishpos")) then
							triggerServerEvent("StopFish", localPlayer, localPlayer)
						else
							getGroundPositionFish()
						end
						cancelEvent()
					end
				end
			end
		elseif(button == "mouse_wheel_up") then
			if(PING) then
				if(TabScroll > 1) then
					TabScroll=TabScroll-1
					UpdateTabEvent()
				end
			end
		elseif(button == "mouse_wheel_down") then
			if(PING) then
				if(MAXSCROLL < TABCurrent) then
					TabScroll=TabScroll+1
					UpdateTabEvent()
				end
			end
		end
	
		if(NewsPaper[1]) then
			if(NewsPaper[2]) then
				if button == "mouse_wheel_down" then
					injectBrowserMouseWheel(NewsPaper[1], -40, 0)
					cancelEvent()
				elseif button == "mouse_wheel_up" then
					injectBrowserMouseWheel(NewsPaper[1], 40, 0)
					cancelEvent()
				elseif button == "escape" then
					CloseNewsPaper()
					cancelEvent()
				end
			end
		end
    end
end
addEventHandler("onClientKey", root, playerPressedKey)



bindKey("tab", "down", UpdateTabEvent)
bindKey("tab", "up", CloseTAB)







function GPS(x,y,z,info,after)
	local GPSM = createMarker(x, y, z, "checkpoint", 5, 255, 50, 50, 170)
	setElementData(GPSM , "type", "GPS")
	GPSObject[GPSM] = createBlipAttachedTo(GPSM)
	if(x ~= 228 and y ~= 228 and z ~= 228) then
		local px, py, pz = getElementPosition(localPlayer)
		triggerServerEvent("GetPathByCoordsNEW", localPlayer, localPlayer, px, py, pz, x,y,z)
	end
	if(info) then setElementData(GPSM, "info", info) end
	if(after) then setElementData(GPSM, "after", after) end
end
addEvent("AddGPSMarker", true)
addEventHandler("AddGPSMarker", root, GPS)




function RemoveGPSMarker(info)
	for k,v in pairs(getElementsByType "marker") do
		if(getElementData(v, "info") == info) then
			destroyElement(GPSObject[v])
			GPSObject[v] = nil
			destroyElement(v)
		end
	end
end
addEvent("RemoveGPSMarker", true)
addEventHandler("RemoveGPSMarker", root, RemoveGPSMarker)



function MarkerHit(hitPlayer, Dimension)
	if(not Dimension) then return false end
	if(hitPlayer == localPlayer) then
		if(getElementData(source, "type") == "GPS") then
			destroyElement(GPSObject[source])
			GPSObject[source] = nil
			if(getElementData(source, "after")) then 
				triggerEvent("helpmessageEvent", localPlayer, getElementData(source, "after"))
				triggerServerEvent("UpdateTutorialByText", localPlayer, localPlayer, getElementData(source, "after"))
			end
			destroyElement(source)
		end
	end
end
addEventHandler("onClientMarkerHit", root, MarkerHit)



local MissionCompletedTimer = false
local MissionCompletedData = {}


function DrawMissionCompleted()
	dxSetRenderTarget(RenderTargets["MissionCompleted"][1], true)
	dxSetBlendMode("modulate_add")
	
	local scale = scale*RenderQuality
	local x = RenderTargets["MissionCompleted"][2]*RenderQuality
	local y = RenderTargets["MissionCompleted"][3]*RenderQuality
	
	if(MissionCompletedData[1]) then
		dxDrawBorderedText("#744D02"..MissionCompletedData[1], x, y/2-dxGetFontHeight(scale*3, "sans")/2, 0, 0, tocolor(255, 255, 255, 255), scale*3, "sans", "center", "top", false, false, false, true, true)
	end
	
	if(MissionCompletedData[2]) then
		if(tonumber(MissionCompletedData[2])) then
			dxDrawBorderedText("$"..MissionCompletedData[2], x, y/2+(dxGetFontHeight(scale*2, "pricedown")/2), 0, 0, tocolor(255, 255, 255, 255), scale*2, "pricedown", "center", "top", false, false, false, true, true)
		else
			dxDrawBorderedText(MissionCompletedData[2], x, y/2+(dxGetFontHeight(scale*3, "sans")/2), 0, 0, tocolor(255, 255, 255, 255), scale*3, "sans", "center", "top", false, false, false, true, true)
		end
	end
	
	dxSetBlendMode("blend")
	dxSetRenderTarget()
	return RenderTargets["MissionCompleted"][1]
end
addEvent("DrawMissionCompletedHandler", true)
addEventHandler("DrawMissionCompletedHandler", resourceRoot, DrawMissionCompleted)




function MissionCompletedRender()
	dxDrawImage(0, 0, RenderTargets["MissionCompleted"][2], RenderTargets["MissionCompleted"][3], RenderTargets["MissionCompleted"][1])
	if(not getCameraTarget()) then
		dxDrawRectangle(0,0,screenWidth, screenHeight/7, tocolor(0,0,0,255))
		dxDrawRectangle(0,screenHeight-(screenHeight/7),screenWidth, screenHeight/7, tocolor(0,0,0,255))
	end
end




function MissionCompleted(job, money)
	MissionCompletedData = {job, money}
	DrawMissionCompleted()	
	if(isTimer(MissionCompletedTimer)) then
		killTimer(MissionCompletedTimer)
	else
		addEventHandler("onClientPreRender", root, MissionCompletedRender)
	end
	
	MissionCompletedTimer = setTimer(function()
		removeEventHandler("onClientPreRender", root, MissionCompletedRender)
		MissionCompletedData = {}
	end, 3500, 1)
	
end
addEvent("MissionCompleted", true)
addEventHandler("MissionCompleted", localPlayer, MissionCompleted)








