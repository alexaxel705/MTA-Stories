end


function DrawPlayer()
	dxSetRenderTarget(RenderTargets["Player"][1], true)
	dxSetBlendMode("modulate_add")

	local scale = scale*RenderQuality
	local scaley = scaley*RenderQuality
	local scalex = scalex*RenderQuality


	dxDrawImage(15*scalex, 60*scaley, 80*scale, 80*scale, "icons/"..getPedWeapon(localPlayer)..".png")
	
	if(getPedAmmoInClip(localPlayer) ~= 0 and getPedTotalAmmo(localPlayer) < 15000) then
		local text = getPedTotalAmmo(localPlayer)-getPedAmmoInClip(localPlayer).." - "..getPedAmmoInClip(localPlayer)
	
		local tw = dxGetTextWidth(text, scale*0.7, "pricedown", true)
		dxDrawTextMoney(text, 95*scalex-(tw/2), 180*scaley, 0, 0, tocolor(120, 150, 186, 255), scale*0.7, "pricedown", "left", "top")
	end
	local timestamp = getRealTime(getElementData(root, "ServerTime"), false)
	local h, m = getTime() -- Для совместимости с другими серверами
	if(timestamp) then
		h, m = timestamp.hour, timestamp.minute 
	end
	local TimePosX, TimePosY = 180*scalex, 65*scaley
	local timesize = 35*scale
	local TimeOff = 19.5*scale
	local Time = string.format("%02.f", h)..":"..string.format("%02.f", m)

	dxDrawImage(TimePosX, TimePosY, timesize, timesize, Pricedown[string.sub(Time, 1, 1)], 0,0,0,tocolor(210,210,210,255))
	dxDrawImage(TimePosX+(TimeOff), TimePosY, timesize,timesize, Pricedown[string.sub(Time, 2, 2)], 0,0,0,tocolor(210,210,210,255))
	dxDrawImage(TimePosX+(TimeOff*2), TimePosY, timesize,timesize, Pricedown[string.sub(Time, 3, 3)], 0,0,0,tocolor(210,210,210,255))
	dxDrawImage(TimePosX+(TimeOff*3), TimePosY, timesize,timesize, Pricedown[string.sub(Time, 4, 4)], 0,0,0,tocolor(210,210,210,255))
	dxDrawImage(TimePosX+(TimeOff*4), TimePosY, timesize,timesize, Pricedown[string.sub(Time, 5, 5)], 0,0,0,tocolor(210,210,210,255))


	
	local armor = getPedArmor(localPlayer)*2
	if(armor > 0) then
		local ArmorX, ArmorY = 180*scalex, 140*scaley
		local maxarmor = 200
		local health = armor/maxarmor
	
		if(health > 1) then health = 1 end
		
		local size2 = maxarmor-10
		dxDrawRectangle(ArmorX, ArmorY, maxarmor*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
		dxDrawRectangle(ArmorX+(5*scalex), ArmorY+(5*scaley), size2*scalex, 14*scaley , tocolor(150, 150, 150, 255), false, true)
		dxDrawRectangle(ArmorX+(5*scalex), ArmorY+(5*scaley), (size2*scalex)*health, 14*scaley , tocolor(230, 230, 230, 255), false, true)
	end
	
	
	local breath = getPedOxygenLevel(localPlayer)
	if(breath < getPedMaxOxygenLevel(localPlayer)) then
		local BreathX, BreathY = 180*scalex, 167*scaley
		local maxbreath = 200
		local bl = breath/getPedMaxOxygenLevel(localPlayer)
	
		if(bl > 1) then bl = 1 end
		
		local size2 = maxbreath-10
		dxDrawRectangle(BreathX, BreathY, maxbreath*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
		dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), size2*scalex, 14*scaley , tocolor(120, 150, 186, 255), false, true)
		dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), (size2*scalex)*bl, 14*scaley , tocolor(170, 200, 236, 255), false, true)
	end
	
	
	local HealthX, HealthY = 180*scalex, 195*scaley
    local stat = getPedStat(localPlayer, 24)
	local health = getElementHealth(localPlayer)/(100+(stat-569)/4.31)
    local maxhealth = 200

	if(health > 1) then health = 1 end
	
	local size2 = maxhealth-10
	dxDrawRectangle(HealthX, HealthY, maxhealth*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
	dxDrawRectangle(HealthX+(5*scalex), HealthY+(5*scaley), size2*scalex, 14*scaley , tocolor(90, 12, 14, 255), false, true)
	dxDrawRectangle(HealthX+(5*scalex), HealthY+(5*scaley), (size2*scalex)*health, 14*scaley , tocolor(180, 25, 29, 255), false, true)

	local MoneyPosX, MoneyPosY = 20*scalex, 225*scaley
	local money = getPlayerMoney(localPlayer)
	local color = tocolor(51,94,42,255)
	if(money < 0) then
		money = money-money-money
		color = tocolor(180, 25, 29,255)
	end
	money = "$"..string.format("%08.f", money)
	local size = 35*scale
	local offset = 19.5*scale
	dxDrawImage(MoneyPosX, MoneyPosY, size, size, Pricedown[string.sub(money, 1, 1)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset), MoneyPosY, size,size, Pricedown[string.sub(money, 2, 2)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*2), MoneyPosY, size,size, Pricedown[string.sub(money, 3, 3)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*3), MoneyPosY, size,size, Pricedown[string.sub(money, 4, 4)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*4), MoneyPosY, size,size, Pricedown[string.sub(money, 5, 5)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*5), MoneyPosY, size,size, Pricedown[string.sub(money, 6, 6)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*6), MoneyPosY, size,size, Pricedown[string.sub(money, 7, 7)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*7), MoneyPosY, size,size, Pricedown[string.sub(money, 8, 8)], 0,0,0,color)
	dxDrawImage(MoneyPosX+(offset*8), MoneyPosY, size,size, Pricedown[string.sub(money, 9, 9)], 0,0,0,color)
	
	local wanted = getElementData(localPlayer, "WantedLevel")
	if(not getElementData(localPlayer, "AEZAKMI")) then
		if(tonumber(wanted)) then
			local WantedPosX, WantedPosY = 20*scalex, 290*scaley
			dxDrawBorderedText("★★★★★★", WantedPosX, WantedPosY, 0, 0, tocolor(40,40,40,200), scale*1.13, "pricedown", "left", "top")
			local tws = dxGetTextWidth("★", scale*1.13, "pricedown", false)
			for i = 1, math.ceil(tonumber(wanted)) do
				dxDrawBorderedText("★", WantedPosX+dxGetTextWidth("★★★★★★", scale*1.13, "pricedown", false)-(tws*i), WantedPosY, 0, 0, tocolor(255,165,0, 200),scale*1.13, "pricedown", "left", "top", nil, nil, nil, true, false)
			end
			
		end
	end
	
	
	local theVehicle = getPedOccupiedVehicle(localPlayer)
	if(theVehicle) then
		local hardtruck = theVehicle
		if(getVehicleTowedByVehicle(theVehicle)) then
			hardtruck = getVehicleTowedByVehicle(theVehicle)
		end
		
		
		if(getElementData(theVehicle, "Fuel")) then
			dxDrawBorderedText("ТОПЛИВО", 0,357*scaley,170*scalex,0, tocolor(200,200,0, 255), scale, "default-bold", "right")
		
			local BreathX, BreathY = 180*scalex, 360*scaley
			local fuelcoeff = 200/getElementData(theVehicle, "MaxFuel")
			local maxbreath = getElementData(theVehicle, "MaxFuel")*fuelcoeff
			local bl = getElementData(theVehicle, "Fuel")*fuelcoeff
			if(bl > 190) then
				bl = 190
			end
			
			local size2 = maxbreath-10
			dxDrawRectangle(BreathX, BreathY, maxbreath*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
			dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), size2*scalex, 14*scaley , tocolor(125,125, 0, 255), false, true)
			dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), bl*scalex, 14*scaley , tocolor(200,200, 0, 255), false, true)
		end
		
		
		if(getElementData(hardtruck, "product")) then
			dxDrawBorderedText(utf8.upper(getElementData(hardtruck, "product")), 0,387*scaley,170*scalex,0, tocolor(170, 200, 236, 255), scale, "default-bold", "right")
		
	
			local BreathX, BreathY = 180*scalex, 390*scaley
			local maxbreath = 200
			local bl = math.floor(getElementHealth(hardtruck)/10)/100
			
			if(bl > 1) then bl = 1 end
			
			local size2 = maxbreath-10
			dxDrawRectangle(BreathX, BreathY, maxbreath*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
			dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), size2*scalex, 14*scaley , tocolor(120, 150, 186, 255), false, true)
			dxDrawRectangle(BreathX+(5*scalex), BreathY+(5*scaley), (size2*scalex)*bl, 14*scaley , tocolor(170, 200, 236, 255), false, true)
		end
	end
	
	
	

	dxSetBlendMode("blend")
	dxSetRenderTarget()
	return RenderTargets["Player"][1]
end



function getPedMaxOxygenLevel(ped)
    assert(isElement(ped) and (getElementType(ped) == "ped" or getElementType(ped) == "player"), "Bad argument @ 'getPedMaxOxygenLevel' [Expected ped at argument 1, got " .. tostring(ped) .. "]")
    local underwater_stamina = getPedStat(ped, 225)
    local stamina = getPedStat(ped, 22)
    local maxoxygen = 1000 + underwater_stamina * 1.5 + stamina * 1.5
    return maxoxygen
end




local GPSObject = {}


function DrawArrow()
	dxSetRenderTarget(RenderTargets["Arrow"][1], true)
	dxSetBlendMode("modulate_add")
	
	local scale = scale*RenderQuality
	
	dxDrawBorderedText("↑", 0, 0, 0, 0, tocolor(200, 0, 0, 255), scale*1.5, "default-bold", "left", "top", nil, nil, nil, true, false)
	dxSetBlendMode("blend")
	dxSetRenderTarget()
	return RenderTargets["Arrow"][1]
end
addEvent("DrawArrowHandler", true)
addEventHandler("DrawArrowHandler", resourceRoot, DrawArrow)



function findRotation(x1, y1, x2, y2) 
    local t = -math.deg(math.atan2(x2 - x1, y2 - y1))
    return t < 0 and t + 360 or t
end

function GetMarrot(angle, rz)
	local marrot = 0
	if(angle > rz) then
		marrot = -(angle-rz)
	else
		marrot = rz-angle
	end
	
	if(marrot > 180) then
		marrot = marrot-360
	elseif(marrot < -180) then
		marrot = marrot+360
	end
	return marrot
end


function removeHex (text, digits)
    assert (type (text) == "string", "Bad argument 1 @ removeHex [String expected, got "..tostring(text).."]")
    assert (digits == nil or (type (digits) == "number" and digits > 0), "Bad argument 2 @ removeHex [Number greater than zero expected, got "..tostring (digits).."]")
    return string.gsub (text, "#"..(digits and string.rep("%x", digits) or "%x+"), "")
end





function DrawWindow()
	if(not getElementData(localPlayer, "HUD")) then return false end
	
	local line = 1
	for v,k in pairs(GPSObject) do
		local x,y,z = getElementPosition(localPlayer)
		local x2,y2,z2 = getElementPosition(v)
		local dist = getDistanceBetweenPoints3D(x,y,z,x2,y2,z2)/2
		if(dist >= 1000) then
			dist = math.round((dist/1000), 1).." ".."км"
		else
			dist = math.round(dist, 0).." ".."м"
		end
		local _,_,rz = getElementRotation(localPlayer)
		local marrot = GetMarrot(findRotation(x,y,x2,y2),rz)
		if(x2 ~= 228 and y2 ~= 228 and z2 ~= 228) then
			dxDrawImage(screenWidth-dxGetTextWidth(getElementData(v, "info").." #A9A9A9"..dist, scale, "default-bold", true)-(20*scale), screenHeight/2.5+(dxGetFontHeight(scale, "default-bold")*line), dxGetTextWidth("↑", scale, "default-bold", false), dxGetFontHeight(scale, "default-bold"), RenderTargets["Arrow"][1], marrot)
			dist = " #A9A9A9"..dist.."\n"
		else
			dist = ""
		end
		dxDrawBorderedText(getElementData(v, "info")..dist, 0, screenHeight/2.5+(dxGetFontHeight(scale, "default-bold")*line), screenWidth-(5*scale), screenHeight, tocolor(200, 200, 200, 255), scale, "default-bold", "right", "top", nil, nil, nil, true)
		line = line+1
	end

	
	if(ZonesDisplay[1]) then
		dxDrawImage(screenWidth-(RenderTargets["Location"][2]+15), screenHeight-(RenderTargets["Location"][3]+15), RenderTargets["Location"][2], RenderTargets["Location"][3], RenderTargets["Location"][1], 0, 0, 0, tocolor(255, 255, 255, ZonesDisplay[1][2]))

		if(tonumber(ZonesDisplay[1][3])) then
			if(ZonesDisplay[1][3] > 0) then
				ZonesDisplay[1][3] = ZonesDisplay[1][3]-5
				if(ZonesDisplay[1][3] <= 255) then
					ZonesDisplay[1][2] = ZonesDisplay[1][3]
				end
			else
				table.remove(ZonesDisplay, 1)
				DrawLocation()
			end
		elseif(ZonesDisplay[1][2] < 255) then
			ZonesDisplay[1][2] = ZonesDisplay[1][2]+5
		elseif(ZonesDisplay[1][2] == 255) then
			if(ZonesDisplay[1][3] == "fast") then
				ZonesDisplay[1][3] = 255
			else
				ZonesDisplay[1][3] = 1200
			end
		end
	end
	
	
	local wanted = getElementData(localPlayer, "WantedLevel")
	if(getElementData(localPlayer, "WantedLevelPrison")) then wanted = getElementData(localPlayer, "WantedLevelPrison") end
	
	local posx, posy = screenWidth-(RenderTargets["Player"][2]), 0
	dxDrawImage(posx, posy, RenderTargets["Player"][2], RenderTargets["Player"][3], DrawPlayer())
	if(not tonumber(wanted)) then
		posx, posy = screenWidth-(screenWidth/4.5), screenHeight/3
		dxDrawBorderedText(wanted, posx, posy, screenWidth, screenHeight, tocolor(200, 200, 200, 180), scale, "default-bold", "left", "top", nil, nil, nil, true)
	end
	
	if(RespectMsg or ToolTipText ~= "") then
		dxDrawImage(15*scalex, 15*scaley, RenderTargets["ToolTip"][2], RenderTargets["ToolTip"][3], RenderTargets["ToolTip"][1], 0, 0, 0)
	end
end
addEventHandler("onClientHUDRender", root, DrawWindow)



function getPlayerCity(thePlayer)
	return getElementData(thePlayer, "City") or "San Andreas"
end



function SetZoneDisplay(zone)
	if(zone ~= "Unknown") then
		if(zone == "Yellow Bell Station") then zone = "Koyoen Station" end
		
		if(ZonesDisplay[#ZonesDisplay]) then
			if(ZonesDisplay[#ZonesDisplay][3]) then
				if(ZonesDisplay[#ZonesDisplay][3] > 255) then
					ZonesDisplay[#ZonesDisplay][3] = 255 -- Для ускорения
				end
			else
				ZonesDisplay[#ZonesDisplay][3] = "fast"
			end
		end
		ZonesDisplay[#ZonesDisplay+1] = {zone, 0, false}
		DrawLocation()
	end
end
addEvent("SetZoneDisplay", true)
addEventHandler("SetZoneDisplay", root, SetZoneDisplay)






local LiquorTrack = false
local LiquorMusic = {
	[1] = "http://"..getElementData(root, "IP").."/engine/include/MTA/music/one-for-my-baby.mp3", 
}



function PlayerNewZone(zone, city, updateweather, withoutblend, interior, dimension)
	if(interior == 18 and withoutblend) then
		if(isElement(LiquorTrack)) then
			destroyElement(LiquorTrack)
		end
		LiquorTrack = playSound3D(LiquorMusic[math.random(#LiquorMusic)], -222.7, 1405.7, 27.8, true)
		setElementInterior(LiquorTrack, interior)
		setElementDimension(LiquorTrack, dimension)
		setSoundMaxDistance(LiquorTrack, 50)
	end
	
	if(interior == 0 and dimension == 0) then
		triggerEvent("SetZoneDisplay", localPlayer, zone)
	end
	triggerServerEvent("ZoneInfo", localPlayer, localPlayer, zone)
end
addEventHandler("PlayerNewZone", root, PlayerNewZone)



function RenderTab()
	if(PING) then
		dxDrawImage(0,0,screenWidth,screenHeight, DrawTabPanel())
	end
end


function UpdateTabEvent()
	IDF, NF, RANG, PING = "","","",""
	TABCurrent = 0
	
	local thePlayers = getElementsByType("player")
	
	if(TabScroll > #thePlayers) then TabScroll = #thePlayers end
	for slot = TabScroll, #thePlayers do
		if(TABCurrent < MAXSCROLL) then
			if(isElement(thePlayers[slot])) then
				local color = getElementData(thePlayers[slot], "color") or "#FFFFFF"
				RANG = RANG..getPlayerCity(thePlayers[slot]).."\n"
				IDF = IDF..getElementData(thePlayers[slot], "id").."\n"
				NF = NF..color..getPlayerName(thePlayers[slot]):gsub('#%x%x%x%x%x%x', '').."\n"
				PING = PING..getPlayerPing(thePlayers[slot]).."\n"
				TABCurrent = TABCurrent+1
			else
				RANG=RANG..thePlayers[slot][2].."\n"
				IDF = IDF..(TABCurrent+1).."\n"
				NF = NF.."#FFFFFF"..thePlayers[slot][1].."\n"
				PING = PING.."0".."\n"
				TABCurrent = TABCurrent+1
			end
		end
	end
	
	addEventHandler("onClientRender", root, RenderTab)
end



function CloseTAB()
	IDF = false
	NF = false
	RANG = false
	PING = false
	removeEventHandler("onClientRender", root, RenderTab)
end




 
