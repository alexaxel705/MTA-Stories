function handleVehicleDamage(attacker, weapon, loss, x, y, z, tyre)
	if(attacker) then
		if(getElementType(attacker) == "vehicle") then
			local acc = getVehicleOccupant(attacker)
			if(acc) then
				if(getElementType(acc) == "player") then
					attacker = acc
				end
			end
		end
		if(attacker == localPlayer) then
			local occupants = getVehicleOccupants(source) or {}
			for seat, occupant in pairs(occupants) do
				if(getElementType(occupant) == "player") then
					if(getTeamName(getPlayerTeam(occupant)) == "Полиция" 
					or getTeamName(getPlayerTeam(occupant)) == "Военные"
					or getTeamName(getPlayerTeam(occupant)) == "ФБР") then
						triggerServerEvent("WantedLevel", localPlayer, localPlayer, 0.1)
					end
				elseif(getElementType(occupant) == "ped") then
					triggerServerEvent("PedDamage", localPlayer, occupant, 228, 0, 0)
				end
			end
			
			
			local color = RGBToHex(255, 255, 0)
			if(weapon) then
				local usedslot = GetUsableSlot()
				if(usedslot) then
					local dam = GetDamageItem(PlayerInventory[usedslot[1]][usedslot[2]])
					loss = math.random(dam[1], dam[2])
				end
			end
			loss = math.round(loss, 0)
			triggerServerEvent("FireVehicle", localPlayer, source, weapon, loss, tyre)

			cancelEvent()
		end
	end
end
addEventHandler("onClientVehicleDamage", root, handleVehicleDamage)





function GetDamageItem(item)
	local mini = math.round(getOriginalWeaponProperty(WeaponNamesArr[item["txd"]], "poor", "damage")*(GetItemQuality(item)/500), 0)-(2)
	local maxi = math.round(getOriginalWeaponProperty(WeaponNamesArr[item["txd"]], "poor", "damage")*(GetItemQuality(item)/500), 0)+(2)
	if(mini < 0) then mini = 0 end 
	return {mini, maxi}
end

function DrawPlayerInterface()
	for _, invname in pairs(InitHudIndex) do
		local InvData = InitHud[invname]
		local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
		local sizex, sizey = EggSize*(#InvData+1)+(150*scale), EggSize*(#InvData[1]+1)
		dxDrawRectangle(sx-(EggSize/2),sy-(EggSize/2),sizex, sizey, tocolor(35,30,30,220))
		HudPosition[invname][3], HudPosition[invname][4] = sizex, sizey
		
		dxDrawBorderedText(invname, sx,sy-(EggSize),sx,sy, tocolor(255, 255, 255, 255), scale*1.5, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
		

		for posx, xdata in pairs(InvData) do -- Решетка
			sy = HudPosition[invname][2]
			local color = tocolor(180,180,180, 20)
			for posy, dat in pairs(xdata) do
				if(DragElement) then
					if(DragElement[1]["name"] and dat["name"]) then
						if(DragElement[2] == invname) then -- Объединяемые предметы
							if(dat["name"] == DragElement[1]["name"]) then
								if(items[dat["name"]][9]) then 
									if(DragElement[3] ~= posx or DragElement[4] ~= posy) then
										if(GetQuality(GetItemQuality(dat)) == GetQuality(GetItemQuality(DragElement[1]))) then
											local ItemSize = items[dat["txd"]][10]
							
											dxDrawRectangle(sx, sy, EggSize*ItemSize[1], EggSize*ItemSize[2],  tocolor(0,153,255,50))
										end
									end
								end
							end
						end
					end
				end
				dxDrawLine(sx, sy, sx+(EggSize), sy, color, 1)
				dxDrawLine(sx, sy, sx, sy+(EggSize), color, 1)
				dxDrawLine(sx, sy+(EggSize), sx+(EggSize), sy+(EggSize), color, 1)
				
				dxDrawLine(sx+(EggSize), sy, sx+(EggSize), sy+(EggSize), color, 1)
				sy=sy+(EggSize)
			end
			sx=sx+(EggSize)
		end
		
		
		sx,sy = HudPosition[invname][1], HudPosition[invname][2]
		for posx, xdata in pairs(InvData) do
			sy = HudPosition[invname][2]
			for posy, dat in pairs(xdata) do
				if(dat["txd"]) then
					local ItemSize = items[dat["txd"]][10]
					
					if(invname == "Инвентарь") then
						if(DragElement) then
							local txdname = DragElement[1]["txd"]
							if(txdname) then
								if(items[txdname][7]) then
									for _, name in ipairs(items[txdname][7]) do
										if(dat["name"] == name) then
											dxDrawRectangle(sx,sy, EggSize*(ItemSize[1]), EggSize*ItemSize[2], tocolor(100,155,100,50))
										end
									end
								end
							end
						end
					end
					
					
					if(ItemSize[2] > ItemSize[1]) then
						dxDrawImage(sx-EggSize,sy, EggSize*(ItemSize[2]+1), EggSize*ItemSize[2], items[dat["txd"]][1])
					elseif(ItemSize[2] < ItemSize[1]) then
						dxDrawImage(sx,sy, EggSize*(ItemSize[1]), EggSize*(ItemSize[2]), items[dat["txd"]][1])
					else
						local d = dxDrawImage(sx-EggSize/2,sy, EggSize*(ItemSize[1]+1), EggSize*ItemSize[2], items[dat["txd"]][1])
					end
			
					if(invname == "Инвентарь") then
						local usedslot = GetUsableSlot()
						if(usedslot) then
							if(posx == usedslot[1] and posy == usedslot[2]) then
								dxDrawBorderedText("Экипирован", sx+5,sy, EggSize, EggSize, tocolor(200, 220, 200, 200), (scale/4)*ItemSize[2], "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
							end
						end
					end
				end

				sy = sy+(EggSize)
			end
			sx = sx+(EggSize)
		end
		
		
		sx,sy = HudPosition[invname][1], HudPosition[invname][2]
		if(ActiveEgg[invname]) then
			local ItemData = InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]
			if(not DragElement) then
				local color = tocolor(180,180,180, 50)
				sx,sy = sx+(EggSize*(ActiveEgg[invname][1]-1)), sy+(EggSize*(ActiveEgg[invname][2]-1))
				if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["txd"]) then
					local ItemSize = items[InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["txd"]][10]
					
					dxDrawLine(sx, sy, sx+(EggSize*ItemSize[1]), sy, color, 1)
					dxDrawLine(sx, sy, sx, sy+(EggSize*ItemSize[2]), color, 1)
					dxDrawLine(sx, sy+(EggSize*ItemSize[2]), sx+(EggSize*ItemSize[1]), sy+(EggSize*ItemSize[2]), color, 1)
					dxDrawLine(sx+(EggSize*ItemSize[1]), sy, sx+(EggSize*ItemSize[1]), sy+(EggSize*ItemSize[2]), color, 1)
				else
					dxDrawLine(sx, sy, sx+(EggSize), sy, color, 1)
					dxDrawLine(sx, sy, sx, sy+(EggSize), color, 1)
					dxDrawLine(sx, sy+(EggSize), sx+(EggSize), sy+(EggSize), color, 1)
					dxDrawLine(sx+(EggSize), sy, sx+(EggSize), sy+(EggSize), color, 1)
				end
			else
				if(DragElement[2] == invname) then
					ItemData = DragElement[1]
				end
			end
			
			
			sx,sy = HudPosition[invname][1], HudPosition[invname][2]
			local InfoPosx, InfoPosy = (sx+sizex)-(150*scale)-EggSize/2, sy
	
			local text = "Пустой слот\n"
			if(ItemData["name"]) then
				text = ItemData["name"].."\n\n"
				text = text.."Цена: "..COLOR["DOLLAR"]["HEX"].."$"..GetItemCost(ItemData)*GetItemCount(ItemData).."\n#FFFFFF"
				text = text.."Вес: "..GetItemMass(ItemData).."\n"
				text = text.."Количество: "..GetItemCount(ItemData).." шт".."\n"
				if(items[ItemData["txd"]][4] == "useinvweapon") then	
					if(getWeaponProperty(WeaponNamesArr[ItemData["txd"]], "poor", "damage")) then
						local damage = GetDamageItem(ItemData)
						text=text.."Урон"..": "..damage[1].." - "..damage[2].."\n"
					end
					if(getWeaponProperty(WeaponNamesArr[ItemData["txd"]], "poor", "weapon_range")) then
						text=text.."Расстояние"..": "..math.round(getWeaponProperty(WeaponNamesArr[ItemData["txd"]], "poor", "weapon_range"), 0).." м\n"
					end
					if(getWeaponProperty(WeaponNamesArr[ItemData["txd"]], "poor", "maximum_clip_ammo")) then
						text=text.."Магазин"..": "..getWeaponProperty(WeaponNamesArr[ItemData["txd"]], "poor", "maximum_clip_ammo").."\n"
					end
					if(WeaponAmmo[WeaponNamesArr[ItemData["txd"]]]) then
						text=text.."Калибр"..": "..WeaponAmmo[WeaponNamesArr[ItemData["txd"]]].."\n"
					end
				elseif(items[ItemData["txd"]][4] == "usedrugs") then	
					text=text.."Здоровье"..": "..math.floor((10+(GetItemQuality(ItemData)/10))).."\n"
				elseif(items[ItemData["txd"]][4] == "usesmoke") then	
					text=text.."Здоровье"..": 5\n"
				end

				text = text.."Качество: "..GetQuality(GetItemQuality(ItemData)).."\n"

				if(items[ItemData["txd"]][8]) then text = text.."\n#FFFFFF".."*Выпадаемый предмет\n" end
			end
			dxDrawBorderedText(text, InfoPosx, InfoPosy ,sx,sy, tocolor(255, 255, 255, 255), scale*0.7, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
		end
	end
	
	if(DragElement) then
		local ItemSize = items[DragElement[1]["txd"]][10]

		local dist, i = 9999, {}
		for invname, InvData in pairs(InitHud) do
			local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
			for ix, xdata in pairs(InvData) do
				for iy, dat in pairs(xdata) do
					local x,y = sx+((EggSize)*(ix-1)), sy+((EggSize)*(iy-1))
					if(getDistanceBetweenPoints2D(x,y, DragX, DragY) < dist) then
						dist = getDistanceBetweenPoints2D(x,y, DragX, DragY)
						i = {x,y}
					end
				end
			end
		end
		
		dxDrawRectangle(i[1],i[2], EggSize*ItemSize[1], EggSize*ItemSize[2], tocolor(70, 70, 70, 50))
		
		if(ItemSize[2] > ItemSize[1]) then
			dxDrawImage(DragX-EggSize,DragY, EggSize*(ItemSize[2]+1), EggSize*ItemSize[2], items[DragElement[1]["txd"]][1])
		elseif(ItemSize[2] < ItemSize[1]) then
			dxDrawImage(DragX,DragY, EggSize*(ItemSize[1]), EggSize*(ItemSize[2]), items[DragElement[1]["txd"]][1])
		else
			dxDrawImage(DragX-EggSize/2,DragY, EggSize*(ItemSize[1]+1), EggSize*ItemSize[2], items[DragElement[1]["txd"]][1])
		end
	end
	
	
	
	
	for name,arr in pairs(PText) do
		for i,el in pairs(arr) do
			color = el[6]
			th = dxGetFontHeight(el[7], el[8])
			tw = dxGetTextWidth(el[1], el[7], el[8], true)
			
			if(MouseX-el[2] <= tw and MouseX-el[2] >= 0) then
				if(MouseY-el[3] <= th and MouseY-el[3] >= 0) then
					if(el[20]) then
						color = tocolor(255,0,0,255)
					end
				end
			end
			
			if(el[19]["border"]) then
				dxDrawBorderedText(el[1], el[2], el[3], el[4], el[5], color, el[7], el[8], el[9], el[10], el[11], el[12], el[13], el[14], el[15], el[16], el[17], el[18])
			else
				dxDrawText(el[1], el[2], el[3], el[4], el[5], color, el[7], el[8], el[9], el[10], el[11], el[12], el[13], el[14], el[15], el[16], el[17], el[18])
			end
			
			if(el[19]["line"]) then
				dxDrawLine(el[2], el[3]+th, el[2]+tw, el[3]+th, color, 1, el[13])
			end
		end
	end
end



function GetItemLink(invname, x,y)
	if(InitHud[invname][x][y]["link"]) then
		return InitHud[invname][x][y]["link"][1], InitHud[invname][x][y]["link"][2]
	else
		return x,y
	end
end



function StartDrag(invname, x,y, absoluteX, absoluteY)
	x,y = GetItemLink(invname, x,y)
	if(invname == "Инвентарь") then
		local usable = GetUsableSlot()
		if(usable) then
			if(x == usable[1] and y == usable[2]) then
				triggerServerEvent("ToolTip", localPlayer, localPlayer, "Нельзя перемещать используемое оружие!")
				return false
			end
		end
	end
	local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
	
	sx,sy = sx+((EggSize)*(x-1)), sy+((EggSize)*(y-1))
	DragStart[1] = absoluteX-sx
	DragStart[2] = absoluteY-sy
	DragX = sx
	DragY = sy

	DragElement = {table.copy(InitHud[invname][x][y]), invname, x,y}
	RemoveInventoryItem(invname, x,y)
end



function StopDrag(absoluteX, absoluteY)
	if(DragElement) then
		local dist = 9999
		local i = false
		local invname2 = ""
		for invname, InvData in pairs(InitHud) do
			local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
			for ix, xdata in pairs(InvData) do
				for iy, dat in pairs(xdata) do
					local x,y = sx+((EggSize)*(ix-1)), sy+((EggSize)*(iy-1))
					if(getDistanceBetweenPoints2D(x,y, DragX, DragY) < dist) then
						dist = getDistanceBetweenPoints2D(x,y, DragX, DragY)
						if(dist < EggSize) then
							i = {ix,iy}
							invname2 = invname
							
							ActiveEgg[invname] = {GetItemLink(invname, ix,iy)}
						end
					end
				end
			end
		end
		
		if(invname2 == "Инвентарь" and DragElement[2] == "Инвентарь") then
			local added = AddInventoryItemNew(DragElement[2], DragElement[1], i[1], i[2])
			if(not added) then
				if(InitHud[invname2][i[1]][i[2]]["name"] == DragElement[1]["name"]) then -- Объединяемые предметы
					if(items[DragElement[1]["name"]][9]) then 
						if(DragElement[3] ~= i[1] or DragElement[4] ~= i[2]) then
							if(GetQuality(GetItemQuality(InitHud[invname2][i[1]][i[2]])) == GetQuality(GetItemQuality(DragElement[1]))) then
								if(InitHud[invname2][i[1]][i[2]]["count"] ~= DragElement[1]["count"]) then 
									table.insert(PData['ExpText'], {"#ff0000разное количество", absoluteX, absoluteY})
									AddInventoryItemNew(DragElement[2], DragElement[1], DragElement[3], DragElement[4]) -- Возвращаем где был
									DragElement = false
									return false 
								end
								InitHud[invname2][i[1]][i[2]]["quality"] = GetItemQuality(DragElement[1])+100
								
								table.insert(PData['ExpText'], {"#ffff99улучшено", absoluteX, absoluteY})
								DragElement = false
								
								triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
								return true
							end
						end
					end
				else
					local txdname = DragElement[1]["txd"]
					if(txdname) then
						if(items[txdname][7]) then
							for _, name in ipairs(items[txdname][7]) do
								if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == name) then
									if(not InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]][DragElement[1]["name"]]) then
										InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]][DragElement[1]["name"]] = DragElement[1]
										DragElement = false
										table.insert(PData['ExpText'], {"#ffff99Установлено", absoluteX, absoluteY})
										triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
										triggerServerEvent("useinvweapon", localPlayer, localPlayer)
										return true
									else
										triggerServerEvent("ToolTip", localPlayer, localPlayer, DragElement[1]["name"].." уже установлен")
									end
								end
							end
						end
					end
				end
				AddInventoryItemNew(DragElement[2], DragElement[1], DragElement[3], DragElement[4]) -- Возвращаем где был
				playSFX("genrl", 53, 3, false)
			else
				if(i[1] ~= DragElement[3] or i[2] ~= DragElement[4]) then
					playSFX("genrl", 53, 1, false)
				end
			end
			DragElement = false
		elseif(invname2 == "Магазин" and DragElement[2] == "Магазин") then
			AddInventoryItemNew(DragElement[2], DragElement[1], DragElement[3], DragElement[4]) -- Возвращаем где был
			DragElement = false
		elseif(invname2 == "Инвентарь" and DragElement[2] == "Магазин") then -- Покупка
			AddInventoryItemNew(DragElement[2], DragElement[1], DragElement[3], DragElement[4]) -- Возвращаем где был
			triggerServerEvent("buyshopitem", localPlayer, localPlayer, 1, {DragElement[1], GetItemCost(DragElement[1]), i[1], i[2]})
			DragElement = false
		elseif(invname2 == "Магазин" and DragElement[2] == "Инвентарь") then -- Продажа
			triggerServerEvent("SellShopItem", localPlayer, localPlayer, GetItemCost(DragElement[1])*GetItemCount(DragElement[1]))
			table.insert(PData['ExpText'], {"+ $"..GetItemCost(DragElement[1])*GetItemCount(DragElement[1]), absoluteX, absoluteY})
			DragElement = false
		else
			if(DragElement[2] == "Инвентарь") then -- Дроп
				triggerServerEvent("NewDropItem", localPlayer, localPlayer, DragElement[1])
			end
			DragElement = false
		end
	end
end




function MoveMouse(x, y, absoluteX, absoluteY)
	MouseX = absoluteX
	MouseY = absoluteY
	if(DragElement) then
		DragX = absoluteX-DragStart[1]
		DragY = absoluteY-DragStart[2]
	elseif(DragInventory) then
		HudPosition[DragInventory][1] = absoluteX-DragStart[1]
		HudPosition[DragInventory][2] = absoluteY-DragStart[2]
	end
end





function GetGroundMaterial(x,y,z,gz) -- Перенести потом все данные GroundMaterial
	x, y = math.round(x, 0), math.round(y, 0)
	local material = false
	local zone = getZoneName(x,y,z,false)
	if(GroundMaterial[zone]) then
		if(GroundMaterial[zone][x]) then
			if(GroundMaterial[zone][x][y]) then
				material = GroundMaterial[zone][x][y]
			end
		end
	end
	if(not material) then _,_,_,_,_,_,_,_,material = processLineOfSight(x,y,z,x,y,gz-1, true,false,false,false,false,true,true,true,localPlayer, true) end
	if(not material) then material = 1337 end
	return material
end



function ValidateMaterialForThree(x,y,z,gz)
	--Исключить: 26, 27
	local materials = {9 ,10 ,11 ,12 ,13 ,14 ,15 ,16 ,17 ,20 ,80 ,81 ,82 ,115 ,116 ,117 ,118 ,119 ,120 ,121 ,122 ,125 ,146 ,147 ,148 ,149 ,150 ,151 ,152 ,153 ,160 ,19 ,21 ,22 ,24 ,25 ,40 ,83 ,84 ,87 ,88 ,100 ,110 ,123 ,124 ,126 ,128 ,129 ,130 ,132 ,133 ,141 ,142 ,145 ,155 ,156}
    local material = GetGroundMaterial(x,y,z,gz)
	for _,k in pairs(materials) do
		if(k == material) then
			return true
		end
	end
	return false
end 





function onClientBrowserWhitelistChange()
	ShowLink()
end
addEventHandler("onClientBrowserWhitelistChange", root, onClientBrowserWhitelistChange)



function ShowLink()
	if(WebLink) then
		if(not isBrowserDomainBlocked(WebLink, true)) then
			if(not NewsPaper[1]) then
				NewsPaper[1] = createBrowser(screenWidth/1.5, screenHeight/1.5, false, false)
				NewsPaper[3] = WebLink
			else
				CloseNewsPaper()
			end
		else
			requestBrowserDomains({WebLink}, true)
		end
	end
end
addEvent("ShowLink", true)
addEventHandler("ShowLink", localPlayer, ShowLink)
bindKey("F5", "down", ShowLink)



function DrawNewsPaper()
	if(NewsPaper[1]) then
		if(NewsPaper[2]) then
			dxDrawImage(screenWidth/6, screenHeight/6, screenWidth/1.5, screenHeight/1.5, NewsPaper[1], 0, 0, 0, tocolor(255,255,255,255), true)
		end
	end
end




local webBrowser = {} 
	



addEventHandler("onClientBrowserCreated", resourceRoot,
    function ()
		loadBrowserURL(source, getElementData(source, "url"))
		setTimer(function(webbr)
			destroyElement(webbr)
		end, 60000*5, 1, source)
    end
)

local WBVehicle = {}

addEventHandler("onClientBrowserDocumentReady", root, 
	function(url) 
		for i, v in pairs(webBrowser) do
			if(v == source) then
				if(getPedOccupiedVehicle(localPlayer)) then
					if(getPedOccupiedVehicle(localPlayer) == i) then
						triggerEvent("SetZoneDisplay", root, getBrowserTitle(source))
					end
				end
			end
		end
	end 
)



function ReadNewsPaper(y,m)
	WebLink = "http://"..getElementData(root, "IP").."/engine/include/MTA/newspaper.php?y="..y.."&m="..m
	if(not isBrowserDomainBlocked(WebLink, true)) then
		if(not NewsPaper[1]) then
			NewsPaper[1] = createBrowser(screenWidth/1.5, screenHeight/1.5, false, false)
			NewsPaper[3] = WebLink
			
			addEventHandler("onClientRender", root, DrawNewsPaper)
		else
			CloseNewsPaper()
		end
	else
		requestBrowserDomains({WebLink, true})
	end
end
addEventHandler("onClientBrowserWhitelistChange", root, ReadNewsPaper)


function onClientBrowserCreated()
	loadBrowserURL(source, NewsPaper[3])
	NewsPaper[2] = true
end
addEventHandler("onClientBrowserCreated", root, onClientBrowserCreated)



function CloseNewsPaper()
	NewsPaper = {false,false,false,false}
end




function FocusInventory(invname)
	local ind, name = false, false
	for id, tname in pairs(InitHudIndex) do
		if(tname == invname) then
			ind, name = id, tname
			break
		end
	end
	if(ind) then
		table.remove(InitHudIndex, ind)
		table.insert(InitHudIndex, name)
	end
end


function UseInventoryItem(x,y)
	local action = items[PlayerInventory[x][y]["txd"]][4]
	if(action) then
		if(action == "useinvweapon") then
			triggerServerEvent("useinvweapon", localPlayer, localPlayer, {x,y})
		elseif(action == "CreateCanabis") then
			local px, py, pz = getElementPosition(localPlayer)
			local gz = getGroundPosition(px, py, pz)
			if(ValidateMaterialForThree(px,py,pz, gz)) then
				triggerServerEvent("CreateThreePlayer", localPlayer, localPlayer, x,y, px,py,gz)
			else
				triggerServerEvent("ToolTip", localPlayer, localPlayer, "Здесь нельзя садить #558833коноплю")
			end
		elseif(action == "CreateRose") then
			local px, py, pz = getElementPosition(localPlayer)
			local gz = getGroundPosition(px, py, pz)
			if(ValidateMaterialForThree(px,py,pz, gz)) then
				triggerServerEvent("CreateThreePlayer", localPlayer, localPlayer, x,y, px,py,gz)
			else
				triggerServerEvent("ToolTip", localPlayer, localPlayer, "Здесь нельзя садить #B90000розы")
			end
			
		elseif(action == "CreateCoka") then
			local px, py, pz = getElementPosition(localPlayer)
			local gz = getGroundPosition(px, py, pz)
			if(ValidateMaterialForThree(px,py,pz, gz)) then
				triggerServerEvent("CreateThreePlayer", localPlayer, localPlayer, x,y, px,py,gz)
			else
				triggerServerEvent("ToolTip", localPlayer, localPlayer, "Здесь нельзя садить коку")
			end
		elseif(action == "usecellphone") then
			triggerServerEvent(action, localPlayer, localPlayer)
		elseif(action == "usedrugs" or action == "usesmoke" or action == "usespunk") then
			RemoveInventoryItemCount(x,y)
			triggerServerEvent(action, localPlayer, localPlayer)
		elseif(action == "usenewspaper") then
			ReadNewsPaper(PlayerInventory[x][y]["date"][2], PlayerInventory[x][y]["date"][1])
		else 
			RemoveInventoryItem("Инвентарь", x,y)
			triggerServerEvent(action, localPlayer, localPlayer)
		end
	end
end






local OldClickObject = ""
local OldClickTimer = false
function addLabelOnClick(button, state, absoluteX, absoluteY, worldX, worldY, worldZ, clickedElement)
	if(button == "right") then
		if(state == "down") then	
			for id = -#InitHudIndex, -1 do -- Перебираем в обратном порядке для окна в фокусе
				id = id-id-id
				invname = InitHudIndex[id]
				local InvData = InitHud[invname]
				local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
				for ix, xdata in pairs(InvData) do
					for iy, dat in pairs(xdata) do
						local x,y = sx+((EggSize)*(ix-1)), sy+((EggSize)*(iy-1))
						local h,w = (EggSize), (EggSize)
						if(absoluteX-x <= h and absoluteX-x >= 0) then
							if(absoluteY-y <= w and absoluteY-y >= 0) then
								FocusInventory(invname)
								ActiveEgg[invname] = {GetItemLink(invname, ix,iy)}
								PText["Inventory"] = {}
							
								if(not table.empty(dat)) then
									PText["Inventory"] = {}
									local FH = dxGetFontHeight(scale, "default-bold")
									local line = 0
									if(invname == "Магазин") then

									elseif(invname == "Инвентарь") then
										if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Pissh" or
										InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Pissh Gold" or
										InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "isabella" or
										InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "KBeer" or
										InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "KBeer Dark") then
											for key,thePlayers in pairs(getElementsByType("player", root, true)) do
												PText["Inventory"][#PText["Inventory"]+1] = {"Посадить "..getPlayerName(thePlayers), absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"butilka", localPlayer, localPlayer, thePlayers, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
												line = line+FH
											end
										elseif(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Кровь") then
											for key,thePlayers in pairs(getElementsByType("player", root, true)) do
												PText["Inventory"][#PText["Inventory"]+1] = {"Вылечить "..getPlayerName(thePlayers), absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"MCHSEvent", localPlayer, localPlayer, thePlayers, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
												line = line+FH
											end
										elseif(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Кока") then
											PText["Inventory"][#PText["Inventory"]+1] = {"Переработать", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"MakeSpunk", localPlayer, localPlayer, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
											line = line+FH
										elseif(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Конопля") then
											PText["Inventory"][#PText["Inventory"]+1] = {"Скрутить косяк", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"MakeKosya", localPlayer, localPlayer, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
											line = line+FH
										elseif(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Фекалии") then
											PText["Inventory"][#PText["Inventory"]+1] = {"Удобрить", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"Udobrenya", localPlayer, localPlayer, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
											line = line+FH										
										elseif(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["name"] == "Запчасти") then
											PText["Inventory"][#PText["Inventory"]+1] = {"Открыть", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"usezapt", localPlayer, localPlayer, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
											
											line = line+FH
										end
										
										if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["Лазерный прицел"]) then
											PText["Inventory"][#PText["Inventory"]+1] = {"Извлечь лазерный прицел", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"UnEquip", localPlayer, localPlayer, invname, ActiveEgg[invname][1],ActiveEgg[invname][2], "Лазерный прицел"}}
											
											line = line+FH
										end
										local WN = WeaponNamesArr[InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["txd"]]
										if(WN) then
											if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]][WeaponAmmo[WN]]) then
												PText["Inventory"][#PText["Inventory"]+1] = {"Извлечь патроны", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"UnEquip", localPlayer, localPlayer, invname, ActiveEgg[invname][1],ActiveEgg[invname][2], "Патроны"}}
											
												line = line+FH
											end
										end
										
										PText["Inventory"][#PText["Inventory"]+1] = {"Выбросить", absoluteX, absoluteY+line, screenWidth, screenHeight, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false, false, false, true, false, 0, 0, 0, {["border"] = true}, {"DropInventoryItem", localPlayer, localPlayer, ActiveEgg[invname][1],ActiveEgg[invname][2]}}
									end
								else
									PText["Inventory"] = {}
								end
							end
						end
					end
				end	
			end
		end
	elseif(button == "left") then
		if(state == "down") then	
			for name,arr in pairs(PText) do
				for i,el in pairs(arr) do
					local color = el[6]
					local FH = dxGetFontHeight(el[7], el[8])
					local FW = dxGetTextWidth(el[1], el[7], el[8], true)
					if(MouseX-el[2] <= FW and MouseX-el[2] >= 0) then
						if(MouseY-el[3] <= FH and MouseY-el[3] >= 0) then
							triggerEvent(unpack(el[20]))
							return true
						end
					end
				end
			end
		
			for id = -#InitHudIndex, -1 do -- Перебираем в обратном порядке для окна в фокусе
				id = id-id-id
				invname = InitHudIndex[id]
				local InvData = InitHud[invname]
				local sx,sy = HudPosition[invname][1], HudPosition[invname][2]
				for ix, xdata in pairs(InvData) do
					for iy, dat in pairs(xdata) do
						local x,y = sx+((EggSize)*(ix-1)), sy+((EggSize)*(iy-1))
						local h,w = (EggSize), (EggSize)
						if(absoluteX-x <= h and absoluteX-x >= 0) then
							if(absoluteY-y <= w and absoluteY-y >= 0) then
								FocusInventory(invname)
								ActiveEgg[invname] = {GetItemLink(invname, ix,iy)}
								
								if(not table.empty(dat)) then
									if(not isTimer(OldClickTimer)) then
										playSFX("genrl", 53, 6, false)
										OldClickObject = invname..ix..iy
									
										OldClickTimer = setTimer(function()
											OldClickObject = ""
										end, 500, 1)
									else
										if(OldClickObject == invname..ix..iy) then
											if(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["ForSale"]) then
												if(items[InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]]["txd"]][3] == 1) then
													triggerServerEvent("buyshopitem", localPlayer, localPlayer, 1, {InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]], GetItemCost(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]])})
												else
													triggerEvent("CreateButtonInputInt", localPlayer, "buyshopitem", "Введи количество", {InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]], GetItemCost(InitHud[invname][ActiveEgg[invname][1]][ActiveEgg[invname][2]])})
												end
												return
											elseif(invname == "Инвентарь") then
												UseInventoryItem(ActiveEgg[invname][1], ActiveEgg[invname][2])
											else
												playSFX("genrl", 53, 3, false)
											end
											killTimer(OldClickTimer)
											OldClickObject = ""
										else
											resetTimer(OldClickTimer)
											playSFX("genrl", 53, 6, false)
											OldClickObject = invname..ix..iy
										end
									end
									
									StartDrag(invname, ix,iy, absoluteX, absoluteY)
									return
								else
									playSFX("genrl", 53, 4, false)
									return
								end
							end
						end
					end
				end
				if((absoluteX-HudPosition[invname][1])+EggSize/2 >= 0 and (absoluteX-HudPosition[invname][1])+EggSize/2 <= HudPosition[invname][3]) then
					if((absoluteY-HudPosition[invname][2])+EggSize/2 >= 0 and (absoluteY-HudPosition[invname][2])+EggSize/2 <= HudPosition[invname][4]) then
						FocusInventory(invname)
						DragStart[1] = absoluteX-sx
						DragStart[2] = absoluteY-sy
						DragInventory = invname
						break
					end
				end
			end
			
			
		elseif(state == "up") then
			StopDrag(absoluteX, absoluteY)
			if(DragInventory) then
				DragInventory = false
			end
		end
	end
end





