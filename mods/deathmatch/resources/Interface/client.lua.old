function UseBind(num)
	if(getElementData(localPlayer, "HUD")) then
		local Elements = 1
		local x = 1
		local y = 1 
		for i = 1, #PlayerInventory*#PlayerInventory[1] do
			if(not PlayerInventory[x]) then
				x = 1
				y = y+1
			end
			
			local item = PlayerInventory[x][y]
			if(item) then
				if(item["txd"]) then
					local action = items[PlayerInventory[x][y]["txd"]][4]
					if(action) then
						if(Elements == tonumber(num)) then
							UseInventoryItem(x,y)
							return true
						end
						Elements = Elements+1
					end
				end
				x = x+1
			end
		end
	end
end




function onClientPlayerWeaponFireFunc(weapon, ammo, ammoInClip, hitX, hitY, hitZ, hitElement)
	if source == localPlayer then
		if(weapon == 41) then
			if(GetObjectType(hitElement) == "Графити") then
				triggerServerEvent("ToolTip", localPlayer, localPlayer, "Доделаю потом")
			end
		elseif(weapon == 42) then
			if(getElementModel(hitElement) == 1362) then
				triggerServerEvent("RemoveFire", localPlayer, localPlayer, getElementData(hitElement, "fireid"))
			end
		elseif(weapon == 43 and getElementModel(source) == 60) then
			triggerServerEvent("doTakeScreenShot", localPlayer)
		else
			local usableslot = GetUsableSlot()
			if(usableslot) then
				if WeaponAmmo[weapon] and not getElementData(localPlayer, "FullClip") then
					local WNA = WeaponAmmo[WeaponNamesArr[PlayerInventory[usableslot[1]][usableslot[2]]["txd"]]]
					PlayerInventory[usableslot[1]][usableslot[2]][WNA]["count"] = PlayerInventory[usableslot[1]][usableslot[2]][WNA]["count"]-1
					if(PlayerInventory[usableslot[1]][usableslot[2]][WNA]["count"] == 0) then
						PlayerInventory[usableslot[1]][usableslot[2]][WNA] = nil
					end
					triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
				end
				
				
				if(PlayerInventory[usableslot[1]][usableslot[2]]["txd"] == UsableWeapon[weapon]) then -- Для гранат
					RemoveInventoryItemCount(usableslot[1], usableslot[2])
					triggerServerEvent("SaveInventory", localPlayer, localPlayer, toJSON(PlayerInventory))
				end
				
			end
			
			if(getPedTotalAmmo(localPlayer) == 0) then
				triggerServerEvent("useinvweapon", localPlayer, localPlayer)
			end
		end
	end
end
addEventHandler("onClientPlayerWeaponFire", localPlayer, onClientPlayerWeaponFireFunc)








function DrawProgressBar(x,y,count,bool,size)
	local scaley = scaley*RenderQuality
	local scalex = scalex*RenderQuality
	
	local size2 = size-10
	dxDrawRectangle(x, y, size*scalex, 24*scaley , tocolor(0, 0, 0, 255), false, true)
	dxDrawRectangle(x+(5*scalex), y+(5*scaley), size2*scalex, 14*scaley , tocolor(100, 100, 100, 255), false, true)
	dxDrawRectangle(x+(5*scalex), y+(5*scaley), ((count/1000)*size2)*scalex, 14*scaley, tocolor(255, 255, 255, 255), false, true)
	
	if(bool) then
		if(bool == 0) then return true end
		if(bool > 0) then
			if(bool < 100) then
				bool = 100
			end
			
			if(count+bool > 1000) then
				bool = 1000-count
				if(bool == 0) then
					count = 900
					bool = 100
				end
			end
			dxDrawRectangle((x+(5*scalex))+(((count/1000)*size2)*scalex), y+(5*scaley), (((bool)/1000)*size2)*scalex, 14*scaley, tocolor(69, 200, 59, 255), false, true)
		else
			if(bool > -100) then
				bool = -100
			end
			
			if(count+bool < 0) then
				bool = -count
				if(bool == 0) then
					count = 100
					bool = -100
				end
			end
			dxDrawRectangle(x+(5*scalex)+(((count/1000)*size2)*scalex), y+(5*scaley), ((bool/1000)*size2)*scalex, 14*scaley, tocolor(255, 0, 0, 255), false, true)
		end
	end
end




local ToolTipText = ""
local ToolTipTimers = false
local RespectMsg = false

function DrawToolTip()
	dxSetRenderTarget(RenderTargets["ToolTip"][1], true)
	dxSetBlendMode("modulate_add")
	
	local scale = scale*RenderQuality
	local scaley = scaley*RenderQuality
	local scalex = scalex*RenderQuality
	
	local linecount = 1
	if(ToolTipText ~= "") then 
		for i in string.gfind(ToolTipText, "\n") do
			linecount = linecount+1
		end
	else
		linecount = 0
	end
	
	local FH = dxGetFontHeight(scale, "default-bold")
	
	local maxtw = 0
	local th = (FH*(linecount))+(20*scaley)
	if(RespectMsg) then
		for v, key in pairs (RespectMsg) do
			tw = dxGetTextWidth(v, scale, "default-bold", true)+(26*scalex)+(150*scalex)+dxGetTextWidth(" +", scale, "default-bold", true) -- 150 размер прогресс бара
			if(tw > maxtw) then
				maxtw = tw
			end
		end
		th = (FH*(linecount+getArrSize(RespectMsg)))+(20*scaley)
	end
	tw = dxGetTextWidth(ToolTipText, scale, "default-bold", true)+(26*scalex)
	if(maxtw > tw) then tw = maxtw end
	dxDrawRectangle(15*scalex, 15*scaley, tw, th, tocolor(0, 0, 0, 180))
	dxDrawText(ToolTipText, 25*scalex, 25*scaley, 0, 0, tocolor(255,255,255,255), scale, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
	
	
	
	if(RespectMsg) then
		for v, key in pairs (RespectMsg) do
			local tw = dxGetTextWidth(v, scale, "default-bold", true)
			dxDrawText(v, 25*scalex, 25*scaley+(FH*(linecount)), screenWidth-170*scalex, 0, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
			DrawProgressBar((25*scalex)+tw+(4*scalex), 30*scaley+(FH*(linecount)), key[2], key[1], 150)
			if(key[1] > 0) then
				dxDrawText("+", 37*scalex+tw+(150*scalex), 25*scaley+(FH*(linecount)), screenWidth-170*scalex, 0, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
			else
				dxDrawText("-", 37*scalex+tw+(150*scalex), 25*scaley+(FH*(linecount)), screenWidth-170*scalex, 0, tocolor(255, 255, 255, 255), scale, "default-bold", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
			end
			linecount = linecount+1
		end
	end
	
	dxSetBlendMode("blend")
	dxSetRenderTarget()
	return RenderTargets["ToolTip"][1]
end
addEvent("DrawToolTipHandler", true)
addEventHandler("DrawToolTipHandler", resourceRoot, DrawToolTip)






function ToolTip(message, skill)
	if(message ~= ToolTipText) then
		playSoundFrontEnd(11)
		if(isTimer(ToolTipTimers)) then
			killTimer(ToolTipTimers)
			ToolTipText = message
			ToolTipTimers = setTimer(function()
				RespectMsg = false
				ToolTipText = ""
			end, 1000+(#message*50), 1)
		else
			ToolTipText = message
			ToolTipTimers = setTimer(function()
				RespectMsg = false
				ToolTipText = ""
			end, 1000+(#message*50), 1)
		end
		DrawToolTip()
	end
end
addEvent("ToolTip", true)
addEventHandler("ToolTip", root, ToolTip)






function getTeamGroup(team)
	if(team == "Мирные жители" or team == "МЧС") then
		return "Мирные жители"
	elseif(team == "Вагос" or team == "Da Nang Boys" or team == "Рифа") then
		return "Синдикат Локо"
	elseif(team == "Баллас" or team == "Колумбийский картель" or team == "Русская мафия") then
		return "Наркомафия"
	elseif(team == "Гроув-стрит" or team == "Триады" or team == "Ацтекас") then
	    return "Бандиты"
	elseif(team == "Полиция" or team == "Военные" or team == "ЦРУ" or team == "ФБР") then
		return "Официалы"
	elseif(team == "Уголовники" or team == "Байкеры" or team == "Деревенщины") then
		return "Уголовники"
	end
end

function getTeamGroupColor(team)
	if(team == "Мирные жители" or team == "МЧС") then
		return "#CCCCCC"
	elseif(team == "Вагос" or team == "Da Nang Boys" or team == "Рифа") then
		return "#A00000"
	elseif(team == "Баллас" or team == "Колумбийский картель" or team == "Русская мафия") then
		return "#B7410E"
	elseif(team == "Гроув-стрит" or team == "Триады" or team == "Ацтекас") then
	    return "#4E653D"
	elseif(team == "Полиция" or team == "Военные" or team == "ЦРУ" or team == "ФБР") then
		return "#4169E1"
	elseif(team == "Уголовники" or team == "Байкеры" or team == "Деревенщины") then
		return "#858585"
	end
end

function GetBandRang(gang,reps)
	local maks = {BandRangs[gang][1]}
	for rang, k in ipairs(BandRangs[gang]) do
		if(k[1] <= reps) then
			maks[1] = k
		else
			if(rang ~= 1) then
				maks[2] = k
				break
			end
		end
	end
	return maks
end




function getTeamVariable(team)
	if(team == "Мирные жители" or team == "МЧС") then
		return tonumber(getElementData(localPlayer, "civilian"))
	elseif(team == "Вагос" or team == "Da Nang Boys" or team == "Рифа") then
		return tonumber(getElementData(localPlayer, "vagos"))
	elseif(team == "Баллас" or team == "Колумбийский картель" or team == "Русская мафия") then
		return tonumber(getElementData(localPlayer, "ballas"))	
	elseif(team == "Гроув-стрит" or team == "Триады" or team == "Ацтекас") then
	    return tonumber(getElementData(localPlayer, "grove"))
	elseif(team == "Полиция" or team == "Военные" or team == "ЦРУ" or team == "ФБР") then
		return tonumber(getElementData(localPlayer, "police"))
	elseif(team == "Уголовники" or team == "Байкеры" or team == "Деревенщины") then
		return tonumber(getElementData(localPlayer, "ugol"))
	end
	return false
end


function RespectMessage(group, count) 
	local name = group
	local myrep = 0
	count = tonumber(count)

	if(SkillLevel[tonumber(group)]) then
		group = tonumber(group)
		for slot = getPedStat(localPlayer, group)+1, getPedStat(localPlayer, group)+count do
			 if SkillLevel[group][slot] then
				triggerEvent("ToolTip", localPlayer, SkillLevel[group][slot])
			 end
		end
	end
	
	if(SkillName[tonumber(group)]) then
		name = SkillName[tonumber(group)]
		myrep = getPedStat(localPlayer, tonumber(group))
	else
		name = getTeamGroupColor(group)..getTeamGroup(group)
		myrep = (getTeamVariable(group)/2)+500
	end
				
	if(isTimer(ToolTipTimers)) then
		if(not RespectMsg[name]) then
			RespectMsg[name] = {count, myrep}
		else
			RespectMsg[name] = {RespectMsg[name][1]+count, myrep}
		end
		resetTimer(ToolTipTimers)
	else
		RespectMsg = {[name] = {count, myrep}}
		ToolTipTimers = setTimer(function()
			RespectMsg = false
			ToolTipText = ""
		end, 3500, 1)
		playSFX("genrl", 52, 15, false)
	end
	DrawToolTip()
end
addEvent("RespectMessage", true)
addEventHandler("RespectMessage", localPlayer, RespectMessage)




local ZonesDisplay = {}

function DrawLocation()
	if(ZonesDisplay[1]) then
		dxSetRenderTarget(RenderTargets["Location"][1], true)
		dxSetBlendMode("modulate_add")
		
		local scale = scale*RenderQuality
		local x = RenderTargets["Location"][2]*RenderQuality
		local y = RenderTargets["Location"][3]*RenderQuality
		
		local tw = dxGetTextWidth(ZonesDisplay[1][1], scale*2, "diploma", true)
		local th = dxGetFontHeight(scale*2, "diploma")
		dxDrawBorderedText(ZonesDisplay[1][1], x-tw-(5*scale), y-th-(5*scale), 0, 0, tocolor(147, 160, 168, 255), scale*2, "diploma", "left", "top", false,false,false,true,not getElementData(localPlayer, "LowPCMode"))
	
		dxSetBlendMode("blend")
		dxSetRenderTarget()
		return RenderTargets["Location"][1]
	end
end
addEvent("DrawLocationHandler", true)
addEventHandler("DrawLocationHandler", resourceRoot, DrawLocation)





local IDF, NF, RANG, PING = false
local TabScroll = 1
