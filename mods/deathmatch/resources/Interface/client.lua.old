function getArrSize(arr)
	local i = 0
	for _,_ in pairs(arr) do i=i+1 end
	return i
end


function getPointInFrontOfPoint(x, y, z, rZ, dist)
	local offsetRot = math.rad(rZ)
	local vx = x + dist * math.cos(offsetRot)
	local vy = y + dist * math.sin(offsetRot)  
	return vx, vy, z
end



function getGroundPositionFish()
	if(not getPedOccupiedVehicle(localPlayer)) then
		if(not isCursorShowing()) then
			local px,py,pz = getElementPosition(localPlayer)
			local _,_,rz = getElementRotation(localPlayer)
			local x,y,z = getPointInFrontOfPoint(px,py,pz, rz+90,10)
			local lvl = getWaterLevel(x,y,z)
			if(lvl) then
				local result = lvl-getGroundPosition(x, y, z)
				if(result > 0) then
					local z = getGroundPosition(x, y, z)
					triggerServerEvent("startfish", localPlayer, localPlayer, x,y,z)
					return
				end
			end
			local r,g,b,a = getWaterColor()
			triggerServerEvent("ToolTip", localPlayer, localPlayer, "Подойди к "..RGBToHex(r,g,b).."воде")
		end
	end
end
addEvent("getGroundPositionFish", true)
addEventHandler("getGroundPositionFish", localPlayer, getGroundPositionFish)





 


function getArrSize(arr)
	local i = 0
	for _,_ in pairs(arr) do i=i+1 end
	return i
end


 




function InitInterface(name, dat)
	if(not InitHud[name]) then
		if(getArrSize(InitHud) == 0) then
			addEventHandler("onClientHUDRender", root, DrawPlayerInterface)
			addEventHandler("onClientClick", root, addLabelOnClick)
			addEventHandler("onClientCursorMove", root, MoveMouse)
			showCursor(true)
		end
		ActiveEgg[name] = {1,1}
		InitHud[name] = dat
		table.insert(InitHudIndex, name)
	else
		ActiveEgg[name] = nil
		InitHud[name] = nil
		
		for id, tname in pairs(InitHudIndex) do
			if(tname == name) then
				table.remove(InitHudIndex, id)
			end
		end
		
		if(getArrSize(InitHud) == 0) then
			removeEventHandler("onClientHUDRender", root, DrawPlayerInterface)
			removeEventHandler("onClientClick", root, addLabelOnClick)
			removeEventHandler("onClientCursorMove", root, MoveMouse)
			showCursor(false)
		end
	end
end
addEvent("InitInterface", true)
addEventHandler("InitInterface", localPlayer, InitInterface)







