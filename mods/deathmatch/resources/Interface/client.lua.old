	dxDrawBorderedText("ник", x+(30*scale), y+(40*scaley), 0, 0, tocolor(74, 140, 178, 255), scale*0.7, "default-bold", "left", "top")
	dxDrawBorderedText("локация", x+(165*scale), y+(40*scaley), 0, 0, tocolor(74, 140, 178, 255), scale*0.7, "default-bold", "left", "top")
	dxDrawBorderedText("пинг", x+(350*scale), y+(40*scaley), 0, 0, tocolor(74, 140, 178, 255), scale*0.7, "default-bold", "left", "top")
	dxDrawLine(510*scalex, 329*scaley, x+(375*scale), 329*scaley, tocolor(120,120,120,255), 1)
	dxDrawRectangle(475*scalex, 810*scaley, 235*scale, 107*scale, tocolor(0, 0, 0, 170))
	dxDrawBorderedText("Итоги", 500*scalex, 780*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*2, "default-bold", "left", "top")
	dxDrawRectangle(975*scalex, 810*scaley, 235*scale, 107*scale, tocolor(0, 0, 0, 170))
	dxDrawBorderedText("Банда", 1000*scalex, 780*scaley, 0, 0, tocolor(255, 255, 255, 255), scale*2, "default-bold", "left", "top")
	
	local team = getTeamName(getPlayerTeam(localPlayer))
