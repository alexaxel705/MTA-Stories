			if(SlowTahometer < MyRPM) then
				SlowTahometer = math.floor(SlowTahometer+((MyRPM-SlowTahometer)/20))
			elseif(SlowTahometer > MyRPM) then
				SlowTahometer = math.floor(SlowTahometer-((SlowTahometer-MyRPM)/20))
			end
		
			local posy = 35*scaley
			local padding = math.floor(4*scale)
			for i = 1, 25 do
				if(i > 14) then
