					else
						dxDrawLine((50*scalex)+(i*padding), y-(5*scaley), (50*scalex)+(i*padding), y-(5*scaley)-posy, tocolor(150,30,30,255), math.floor(3*scale))
					end
				end
			end
			
	
			
			dxDrawBorderedText("RPM", 0, y-(70*scaley),162*scalex,0, tocolor(140,140,140,255), scale/2, "default-bold", "right")
